{% comment %}
  Celestial Sun & Crescent Moon Emblem
  Renders the hand-drawn line art emblem with clean transparency.
  Uses CSS mask-image so it dynamically inherits the custom emblem_color (currentColor).
{% endcomment %}
<span class="pj-celestial-emblem" aria-hidden="true">
  <span
    class="pj-celestial-emblem__mask"
    style="--pj-emblem-mask-url: url('{{ 'celestial-sun-moon.png' | asset_url }}');"
  ></span>
  <img
    src="{{ 'celestial-sun-moon.png' | asset_url }}"
    alt="Celestial Sun and Moon Emblem"
    class="pj-celestial-emblem__fallback"
    width="387"
    height="462"
    loading="lazy"
  >
</span>
