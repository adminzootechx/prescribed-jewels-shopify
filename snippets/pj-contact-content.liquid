{%- liquid
  assign heading = heading | default: 'Get in Touch'
  assign subtext = subtext | default: "We'd love to hear from you. Whether you're enquiring about a piece, arranging a virtual appointment, or exploring a bespoke creation, our team is here to assist."
  assign email = email | default: 'hello@prescribedjewels.com'
  assign insta_handle = insta_handle | default: 'prescribed.jewels'
  assign insta_url = insta_url | default: 'https://www.instagram.com/prescribed.jewels?exln=dGVsc2ZjdTloM2g='
  assign btn_label = btn_label | default: 'Send'
-%}

<div class="pj-contact-page">
  <div class="pj-container pj-contact-page__container">
    <!-- Top Centered Header (Matching Reference Layout) -->
    <div class="pj-contact-page__header">
      <h1 class="pj-contact-page__title">{{ heading }}</h1>
      <p class="pj-contact-page__lead">{{ subtext }}</p>

      <div class="pj-contact-page__meta">
        <a href="mailto:{{ email }}" class="pj-contact-page__meta-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{{ email }}</span>
        </a>

        <span class="pj-contact-page__meta-sep" aria-hidden="true">·</span>

        <a
          href="{{ insta_url }}"
          class="pj-contact-page__meta-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram @{{ insta_handle }}"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
          </svg>
          <span>@{{ insta_handle }}</span>
        </a>
      </div>
    </div>

    <!-- Bottom 2-Column Split: Photo Left, Form Right -->
    <div class="pj-contact-page__split">
      <div class="pj-contact-page__media">
        {%- if image != blank -%}
          {{ image | image_url: width: 1200 | image_tag: class: 'pj-contact-page__img', widths: '500, 800, 1200', sizes: '(min-width: 900px) 46vw, 100vw', alt: heading, loading: 'eager' }}
        {%- else -%}
          <img
            src="{{ 'contact-portrait.jpg' | asset_url }}"
            alt="{{ heading | escape }}"
            class="pj-contact-page__img"
            width="607"
            height="424"
            loading="eager"
          >
        {%- endif -%}
      </div>

      <div class="pj-contact-page__form-wrap">
        {%- form 'contact', id: 'pj-contact-page-form', class: 'pj-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="pj-contact-form__success" role="status" tabindex="-1" autofocus>
              <span class="pj-contact-form__success-badge">MESSAGE SENT</span>
              <p>Thank you for getting in touch. Our team will get back to you shortly.</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="pj-contact-form__errors" role="alert" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="pj-contact-form__row pj-contact-form__row--two">
            <div class="pj-contact-form__field">
              <label for="pj-contact-name" class="pj-visually-hidden">Name</label>
              <input
                type="text"
                id="pj-contact-name"
                name="contact[name]"
                class="pj-contact-form__input"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Name"
              >
            </div>

            <div class="pj-contact-form__field">
              <label for="pj-contact-email" class="pj-visually-hidden">Email *</label>
              <input
                type="email"
                id="pj-contact-email"
                name="contact[email]"
                class="pj-contact-form__input"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="Email *"
                autocorrect="off"
                autocapitalize="off"
                required
              >
            </div>
          </div>

          <div class="pj-contact-form__row">
            <div class="pj-contact-form__field">
              <label for="pj-contact-phone" class="pj-visually-hidden">Phone number</label>
              <input
                type="tel"
                id="pj-contact-phone"
                name="contact[phone]"
                class="pj-contact-form__input"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="Phone number"
              >
            </div>
          </div>

          <div class="pj-contact-form__row">
            <div class="pj-contact-form__field">
              <label for="pj-contact-body" class="pj-visually-hidden">Comment</label>
              <textarea
                id="pj-contact-body"
                name="contact[body]"
                class="pj-contact-form__textarea"
                rows="5"
                placeholder="Comment"
                required
              >{{ form.body }}</textarea>
            </div>
          </div>

          <div class="pj-contact-form__actions">
            <button type="submit" class="pj-contact-form__submit">
              {{ btn_label }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>
