{%- liquid
  assign fallbacks = 'design-01-classic.jpg,design-02-solace.jpg,design-03-balance.jpg,design-04-aura.jpg,design-05-signet.jpg,design-06-celestial.jpg,design-07-bespoke.jpg' | split: ','

  assign path_downcase = request.path | downcase
  assign default_idx = placeholder_design | default: 1 | minus: 1
  assign design_title = placeholder_title | default: 'The Classic — Signature Ring'
  assign design_price = placeholder_price | default: '$2,400'
  assign design_desc = placeholder_description | default: '<p>A timeless solitaire silhouette in solid 18k gold, designed to be worn every day. The centre stone is not chosen from a menu — it is prescribed for you from your date, time, city and country of birth.</p>'

  if path_downcase contains 'solace'
    assign default_idx = 1
    assign design_title = 'The Solace — Signature Pendant'
    assign design_price = '$2,100'
    assign design_desc = '<p>An intimate everyday pendant worn close to the heart, set in solid gold with the single natural gemstone prescribed by our Vedic astrologer from your date, time, city and country of birth.</p>'
  elsif path_downcase contains 'balance'
    assign default_idx = 2
    assign design_title = 'The Balance — Signature Bracelet'
    assign design_price = '$2,650'
    assign design_desc = '<p>A refined gold bracelet balanced around your prescribed natal gemstone, crafted for effortless everyday wear and accompanied by your personal gemstone prescription.</p>'
  elsif path_downcase contains 'aura'
    assign default_idx = 3
    assign design_title = 'The Aura — Signature Drop Earrings'
    assign design_price = '$2,800'
    assign design_desc = '<p>Luminous drop earrings pairing architectural goldwork with your personally prescribed gemstone, selected from your birth date, time, city and country.</p>'
  elsif path_downcase contains 'signet'
    assign default_idx = 4
    assign design_title = 'The Signet — Signature Crest Ring'
    assign design_price = '$2,950'
    assign design_desc = '<p>A modern heirloom signet ring in solid gold, centering the natural gemstone prescribed from your natal birth chart.</p>'
  elsif path_downcase contains 'celestial'
    assign default_idx = 5
    assign design_title = 'The Celestial — Signature Medallion'
    assign design_price = '$3,100'
    assign design_desc = '<p>A sculptural talisman medallion inspired by celestial geometry, holding the natural gemstone prescribed from your birth details.</p>'
  elsif path_downcase contains 'custom' or path_downcase contains 'bespoke'
    assign default_idx = 6
    assign design_title = 'Custom — Bespoke Commission'
    assign design_price = 'By Consultation'
    assign design_desc = '<p>A one-of-a-kind bespoke creation tailored around your prescribed gemstone and personal silhouette preferences, crafted in 5–7 weeks.</p>'
  endif

  assign has_real_product = false
  if product != blank and product.id != blank
    assign has_real_product = true
    assign current_variant = product.selected_or_first_available_variant
    assign design_title = product.title
  endif

  assign has_media = false
  if has_real_product and product.media.size > 0
    assign has_media = true
  endif
-%}

<div class="pj-pdp__container">
  <nav class="pj-pdp__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <a href="{{ routes.root_url }}#pj-designs">The Seven Designs</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page" data-pdp-crumb-title>{{ design_title }}</span>
  </nav>

  <!-- Quick Design Selector Pills (Placeholder Preview Switcher) -->
  <div class="pj-pdp__design-pills" role="navigation" aria-label="Switch design">
    <a href="/products/the-classic" class="pj-pdp__design-pill{% if default_idx == 0 %} is-active{% endif %}">01 · The Classic</a>
    <a href="/products/the-solace" class="pj-pdp__design-pill{% if default_idx == 1 %} is-active{% endif %}">02 · The Solace</a>
    <a href="/products/the-balance" class="pj-pdp__design-pill{% if default_idx == 2 %} is-active{% endif %}">03 · The Balance</a>
    <a href="/products/the-aura" class="pj-pdp__design-pill{% if default_idx == 3 %} is-active{% endif %}">04 · The Aura</a>
    <a href="/products/the-signet" class="pj-pdp__design-pill{% if default_idx == 4 %} is-active{% endif %}">05 · The Signet</a>
    <a href="/products/the-celestial" class="pj-pdp__design-pill{% if default_idx == 5 %} is-active{% endif %}">06 · The Celestial</a>
    <a href="/products/custom-bespoke" class="pj-pdp__design-pill{% if default_idx == 6 %} is-active{% endif %}">07 · Custom</a>
  </div>

  <div class="pj-pdp__grid">
    <!-- GALLERY -->
    <div class="pj-pdp__gallery" data-pdp-gallery>
      <div class="pj-pdp__stage">
        {%- if has_media -%}
          {%- for media in product.media limit: 6 -%}
            <div class="pj-pdp__slide{% if forloop.first %} is-active{% endif %}" data-pdp-slide="{{ forloop.index0 }}">
              {{ media.preview_image | image_url: width: 1400 | image_tag: class: 'pj-pdp__img', widths: '600, 900, 1200, 1400', sizes: '(min-width: 960px) 55vw, 100vw', alt: media.alt | default: design_title, loading: 'eager' }}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (0..3) -%}
            {%- assign idx = default_idx | plus: i | modulo: 7 -%}
            <div class="pj-pdp__slide{% if forloop.first %} is-active{% endif %}" data-pdp-slide="{{ forloop.index0 }}">
              <img src="{{ fallbacks[idx] | asset_url }}" alt="{{ design_title | escape }} — view {{ forloop.index }}" class="pj-pdp__img" width="900" height="1200" loading="eager">
            </div>
          {%- endfor -%}
        {%- endif -%}
        <span class="pj-pdp__badge">Personal gemstone selection included</span>
      </div>

      <div class="pj-pdp__thumbs" role="tablist" aria-label="Product images">
        {%- if has_media -%}
          {%- for media in product.media limit: 6 -%}
            <button type="button" class="pj-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-pdp-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}
            </button>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (0..3) -%}
            {%- assign idx = default_idx | plus: i | modulo: 7 -%}
            <button type="button" class="pj-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-pdp-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
              <img src="{{ fallbacks[idx] | asset_url }}" alt="" width="120" height="160" loading="lazy">
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!-- DETAILS + NATAL BIRTH DETAILS FORM -->
    <div class="pj-pdp__details">
      <p class="pj-pdp__eyebrow">{{ eyebrow | default: 'SIGNATURE DESIGN · PRESCRIBED JEWELS' }}</p>
      <h1 id="pj-pdp-title" class="pj-pdp__title">{{ design_title }}</h1>

      <div class="pj-pdp__price-row">
        <p class="pj-pdp__price">
          {%- if has_real_product and current_variant.price > 0 -%}
            {{ current_variant.price | money }}
          {%- else -%}
            {{ design_price }}
          {%- endif -%}
        </p>
        {%- if has_real_product and current_variant.compare_at_price > current_variant.price -%}
          <s class="pj-pdp__compare">{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </div>
      <p class="pj-pdp__price-note">{{ price_note | default: 'The personal gemstone selection is included.' }}</p>

      <div class="pj-pdp__desc">
        {%- if has_real_product and product.description != blank -%}
          {{ product.description }}
        {%- else -%}
          {{ design_desc }}
        {%- endif -%}
      </div>

      <ol class="pj-pdp__steps" aria-label="Your order journey">
        <li class="is-done"><span>01 · DISCOVER</span> Seven Designs</li>
        <li class="is-done"><span>02 · SELECT</span> Design &amp; Price</li>
        <li class="is-current"><span>03 · PERSONALIZE</span> Birth Details</li>
        <li><span>04 · PURCHASE</span> Checkout</li>
        <li><span>05 · CREATE</span> Prescribe &amp; Craft</li>
      </ol>

      {%- if has_real_product -%}
        {%- form 'product', product, id: 'pj-pdp-form', class: 'pj-pdp__form', data-pdp-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="return_to" value="/checkout">

          {%- unless product.has_only_default_variant -%}
            <div class="pj-pdp__field">
              <label for="pj-pdp-variant" class="pj-pdp__label">{{ product.options | join: ' / ' }}</label>
              <select id="pj-pdp-variant" name="id" class="pj-pdp__input">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endunless -%}

          <fieldset class="pj-pdp__birth">
            <legend class="pj-pdp__legend">
              <span class="pj-pdp__legend-title">03 · Personalize — Enter Birth Details</span>
              <span class="pj-pdp__legend-sub">Required before payment. Our astrologer requires your birth date, exact time, city and country of birth.</span>
            </legend>

            <div class="pj-pdp__birth-grid">
              <div class="pj-pdp__field">
                <label for="pj-pdp-date" class="pj-pdp__label">Date of Birth <span class="pj-pdp__req">*</span></label>
                <input type="date" id="pj-pdp-date" name="properties[Birth Date]" class="pj-pdp__input" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-time" class="pj-pdp__label">Time of Birth <span class="pj-pdp__req">*</span></label>
                <input type="time" id="pj-pdp-time" name="properties[Birth Time]" class="pj-pdp__input" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-city" class="pj-pdp__label">City of Birth <span class="pj-pdp__req">*</span></label>
                <input type="text" id="pj-pdp-city" name="properties[Birth City]" class="pj-pdp__input" placeholder="e.g. Jaipur" autocomplete="off" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-country" class="pj-pdp__label">Country of Birth <span class="pj-pdp__req">*</span></label>
                <select id="pj-pdp-country" name="properties[Birth Country]" class="pj-pdp__input" required>
                  <option value="" selected disabled>Select country</option>
                  {{ all_country_option_tags }}
                </select>
              </div>
            </div>

            <label class="pj-pdp__check">
              <input type="checkbox" name="properties[Birth Time Approximate]" value="Yes">
              <span>My birth time is approximate</span>
            </label>
          </fieldset>

          <p class="pj-pdp__error" role="alert" hidden data-pdp-error>
            Please complete all birth details — date, time, city and country of birth — before proceeding to checkout.
          </p>

          <button type="submit" class="pj-pdp__submit" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}
              <span>04 · Complete Secure Shopify Checkout</span>
              <span aria-hidden="true">→</span>
            {%- else -%}
              <span>Sold Out</span>
            {%- endif -%}
          </button>

          <p class="pj-pdp__secure">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            Secure Shopify checkout · Shipping, payment &amp; order confirmation
          </p>
        {%- endform -%}
      {%- else -%}
        <!-- Placeholder Product Form (Works without requiring a backend Shopify product) -->
        <form id="pj-pdp-form" class="pj-pdp__form" data-pdp-form data-placeholder-form novalidate>
          <div class="pj-pdp__field">
            <label for="pj-pdp-metal" class="pj-pdp__label">Select Precious Metal</label>
            <select id="pj-pdp-metal" name="metal" class="pj-pdp__input">
              <option value="18k Yellow Gold" selected>18k Solid Yellow Gold — {{ design_price }}</option>
              <option value="18k Rose Gold">18k Solid Rose Gold — {{ design_price }}</option>
              <option value="18k White Gold">18k Solid White Gold — {{ design_price }}</option>
              <option value="Platinum">Platinum 950 — {{ design_price }}</option>
            </select>
          </div>

          <fieldset class="pj-pdp__birth">
            <legend class="pj-pdp__legend">
              <span class="pj-pdp__legend-title">03 · Personalize — Enter Birth Details</span>
              <span class="pj-pdp__legend-sub">Required before payment. Our astrologer requires your birth date, exact time, city and country of birth.</span>
            </legend>

            <div class="pj-pdp__birth-grid">
              <div class="pj-pdp__field">
                <label for="pj-pdp-date" class="pj-pdp__label">Date of Birth <span class="pj-pdp__req">*</span></label>
                <input type="date" id="pj-pdp-date" name="birth_date" class="pj-pdp__input" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-time" class="pj-pdp__label">Time of Birth <span class="pj-pdp__req">*</span></label>
                <input type="time" id="pj-pdp-time" name="birth_time" class="pj-pdp__input" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-city" class="pj-pdp__label">City of Birth <span class="pj-pdp__req">*</span></label>
                <input type="text" id="pj-pdp-city" name="birth_city" class="pj-pdp__input" placeholder="e.g. Jaipur" autocomplete="off" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-country" class="pj-pdp__label">Country of Birth <span class="pj-pdp__req">*</span></label>
                <select id="pj-pdp-country" name="birth_country" class="pj-pdp__input" required>
                  <option value="" selected disabled>Select country</option>
                  {{ all_country_option_tags }}
                </select>
              </div>
            </div>

            <label class="pj-pdp__check">
              <input type="checkbox" name="birth_time_approx" value="Yes">
              <span>My birth time is approximate</span>
            </label>
          </fieldset>

          <p class="pj-pdp__error" role="alert" hidden data-pdp-error>
            Please complete all birth details — date, time, city and country of birth — before proceeding to checkout.
          </p>

          <div class="pj-pdp__success" role="status" hidden data-pdp-success>
            <strong>04 · Ready for Checkout — Birth Details Recorded</strong>
            <p data-pdp-summary></p>
          </div>

          <button type="submit" class="pj-pdp__submit">
            <span>04 · Complete Secure Shopify Checkout</span>
            <span aria-hidden="true">→</span>
          </button>

          <p class="pj-pdp__secure">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            Secure Shopify checkout · Shipping, payment &amp; order confirmation
          </p>
        </form>
      {%- endif -%}

      <div class="pj-pdp__accordions">
        <details class="pj-pdp__acc" open>
          <summary>What's Included</summary>
          <div class="pj-pdp__acc-body">{{ included_text | default: 'Your chosen fine jewelry design, a natural gemstone prescribed from your birth details (date, time, city and country) by our Vedic astrologer, a personal prescription card explaining your stone and its meaning, and signature Prescribed Jewels packaging.' }}</div>
        </details>
        <details class="pj-pdp__acc">
          <summary>The Prescription &amp; Timeline</summary>
          <div class="pj-pdp__acc-body">{{ timeline_text | default: 'Day 0 — Order placed with your birth date, time, city and country. Days 1–5 — Our astrologer prescribes your gemstone. Days 3–7 — Your gemstone and its meaning are revealed by email. Weeks 5–7 — Your jewel is crafted, quality-checked and delivered.' }}</div>
        </details>
        <details class="pj-pdp__acc">
          <summary>Shipping &amp; Care</summary>
          <div class="pj-pdp__acc-body">{{ shipping_text | default: 'Insured worldwide shipping with tracking. Store your piece in its signature box, avoid perfumes and harsh chemicals, and wipe gently with a soft lint-free cloth after wear.' }}</div>
        </details>
      </div>
    </div>
  </div>
</div>

<!-- 5-Step Ordering Journey (Matching Reference Image) -->
<div class="pj-journey pj-pdp__journey-wrap">
  <div class="pj-journey__inner">
    <div class="pj-journey__card">
      <ol class="pj-journey__list">
        <li class="pj-journey__step">
          <p class="pj-journey__label">01 · DISCOVER</p>
          <h3 class="pj-journey__step-title">Explore the seven designs</h3>
          <p class="pj-journey__step-text">Understand the jewelry and the prescription concept</p>
        </li>
        <li class="pj-journey__arrow" aria-hidden="true">↓</li>
        <li class="pj-journey__step">
          <p class="pj-journey__label">02 · SELECT</p>
          <h3 class="pj-journey__step-title">Choose a design and see its price</h3>
          <p class="pj-journey__step-text">The personal gemstone selection is included</p>
        </li>
        <li class="pj-journey__arrow" aria-hidden="true">↓</li>
        <li class="pj-journey__step">
          <p class="pj-journey__label">03 · PERSONALIZE</p>
          <h3 class="pj-journey__step-title">Enter birth details</h3>
          <p class="pj-journey__step-text">Date, time, city and country of birth — required before payment</p>
        </li>
        <li class="pj-journey__arrow" aria-hidden="true">↓</li>
        <li class="pj-journey__step">
          <p class="pj-journey__label">04 · PURCHASE</p>
          <h3 class="pj-journey__step-title">Complete secure Shopify checkout</h3>
          <p class="pj-journey__step-text">Shipping, payment and order confirmation</p>
        </li>
        <li class="pj-journey__arrow" aria-hidden="true">↓</li>
        <li class="pj-journey__step">
          <p class="pj-journey__label">05 · CREATE</p>
          <h3 class="pj-journey__step-title">We prescribe, craft and deliver</h3>
          <p class="pj-journey__step-text">The jewelry arrives with its personal prescription</p>
        </li>
      </ol>
    </div>
  </div>
</div>

<script>
  (() => {
    const scripts = document.querySelectorAll('script');
    const currentScript = document.currentScript || scripts[scripts.length - 1];
    const root = currentScript.closest('.pj-pdp') || document;

    const slides = root.querySelectorAll('[data-pdp-slide]');
    const thumbs = root.querySelectorAll('[data-pdp-thumb]');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const i = thumb.dataset.pdpThumb;
        slides.forEach((sl) => sl.classList.toggle('is-active', sl.dataset.pdpSlide === i));
        thumbs.forEach((t) => t.classList.toggle('is-active', t === thumb));
      });
    });

    const form = root.querySelector('[data-pdp-form]');
    const error = root.querySelector('[data-pdp-error]');
    const success = root.querySelector('[data-pdp-success]');
    const summary = root.querySelector('[data-pdp-summary]');

    if (form) {
      form.addEventListener('submit', (e) => {
        const required = Array.from(form.querySelectorAll('[required]'));
        const missing = required.filter((f) => !String(f.value || '').trim());
        required.forEach((f) => f.classList.toggle('is-invalid', missing.includes(f)));

        if (missing.length) {
          e.preventDefault();
          if (error) error.hidden = false;
          if (success) success.hidden = true;
          missing[0].focus();
          return;
        }

        if (error) error.hidden = true;

        if (form.hasAttribute('data-placeholder-form')) {
          e.preventDefault();
          const bDate = form.querySelector('[name="birth_date"]')?.value || '';
          const bTime = form.querySelector('[name="birth_time"]')?.value || '';
          const bCity = form.querySelector('[name="birth_city"]')?.value || '';
          const bCountry = form.querySelector('[name="birth_country"]')?.value || '';

          // Pre-fill the prescription modal if present, or show inline confirmation
          const modal = document.getElementById('pj-prescription-modal');
          if (modal && typeof modal.showModal === 'function') {
            const mDate = modal.querySelector('#pj-birth-date');
            const mTime = modal.querySelector('#pj-birth-time');
            const mCity = modal.querySelector('#pj-birth-city');
            const mCountry = modal.querySelector('#pj-birth-country');
            if (mDate) mDate.value = bDate;
            if (mTime) mTime.value = bTime;
            if (mCity) mCity.value = bCity;
            if (mCountry) mCountry.value = bCountry;
            modal.showModal();
          } else if (success && summary) {
            summary.textContent = `Birth details logged (${bDate} at ${bTime}, ${bCity}, ${bCountry}). Connect a live Shopify product to proceed directly to payment.`;
            success.hidden = false;
          }
        }
      });

      form.addEventListener('input', (e) => {
        if (e.target.classList.contains('is-invalid') && String(e.target.value).trim()) {
          e.target.classList.remove('is-invalid');
        }
      });
    }
  })();
</script>
