{%- liquid
  assign fallbacks = 'design-01-classic.jpg,design-02-solace.jpg,design-03-balance.jpg,design-04-aura.jpg,design-05-signet.jpg,design-06-celestial.jpg,design-07-bespoke.jpg' | split: ','

  assign default_idx = placeholder_design | default: 1 | minus: 1
  assign design_title = placeholder_title | default: 'The Classic — Signature Ring'
  assign design_price = placeholder_price | default: '$2,400'
  assign design_desc = placeholder_description | default: '<p>A timeless solitaire silhouette in solid 18k gold, designed to be worn every day. The centre stone is not chosen from a menu — it is prescribed for you from your date, time, city and country of birth.</p>'

  assign has_real_product = false
  if product != blank and product.id != blank
    assign has_real_product = true
    assign current_variant = product.selected_or_first_available_variant
    assign design_title = product.title
  endif

  assign has_media = false
  if has_real_product and product.media.size > 0
    assign has_media = true
  endif
-%}

<div class="pj-pdp__container" data-pdp-root data-has-real-product="{{ has_real_product }}">
  <nav class="pj-pdp__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <a href="{{ routes.root_url }}#pj-designs">The Collection</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page" data-pdp-crumb-title>{{ design_title }}</span>
  </nav>

  <div class="pj-pdp__grid">
    <!-- GALLERY (Shows ONLY this product's photo(s)) -->
    <div class="pj-pdp__gallery{% unless has_media and product.media.size > 1 %} pj-pdp__gallery--single{% endunless %}" data-pdp-gallery>
      <div class="pj-pdp__stage">
        {%- if has_media -%}
          {%- for media in product.media limit: 6 -%}
            <div class="pj-pdp__slide{% if forloop.first %} is-active{% endif %}" data-pdp-slide="{{ forloop.index0 }}">
              {{ media.preview_image | image_url: width: 1400 | image_tag: class: 'pj-pdp__img', widths: '600, 900, 1200, 1400', sizes: '(min-width: 960px) 55vw, 100vw', alt: media.alt | default: design_title, loading: 'eager' }}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="pj-pdp__slide is-active" data-pdp-slide="0">
            <img
              src="{{ fallbacks[default_idx] | asset_url }}"
              alt="{{ design_title | escape }}"
              class="pj-pdp__img"
              data-pdp-main-img
              width="900"
              height="1200"
              loading="eager"
            >
          </div>
        {%- endif -%}
        <span class="pj-pdp__badge">Personal gemstone selection included</span>
      </div>

      {%- if has_media and product.media.size > 1 -%}
        <div class="pj-pdp__thumbs" role="tablist" aria-label="Product images">
          {%- for media in product.media limit: 6 -%}
            <button type="button" class="pj-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-pdp-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- DETAILS + NATAL BIRTH DETAILS FORM -->
    <div class="pj-pdp__details">
      <p class="pj-pdp__eyebrow">{{ eyebrow | default: 'SIGNATURE DESIGN · PRESCRIBED JEWELS' }}</p>
      <h1 id="pj-pdp-title" class="pj-pdp__title" data-pdp-title>{{ design_title }}</h1>

      <div class="pj-pdp__price-row">
        <p class="pj-pdp__price" data-pdp-price>
          {%- if has_real_product and current_variant.price > 0 -%}
            {{ current_variant.price | money }}
          {%- else -%}
            {{ design_price }}
          {%- endif -%}
        </p>
        {%- if has_real_product and current_variant.compare_at_price > current_variant.price -%}
          <s class="pj-pdp__compare">{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </div>
      <p class="pj-pdp__price-note">{{ price_note | default: 'The personal gemstone selection is included.' }}</p>

      <div class="pj-pdp__desc" data-pdp-desc>
        {%- if has_real_product and product.description != blank -%}
          {{ product.description }}
        {%- else -%}
          {{ design_desc }}
        {%- endif -%}
      </div>

      {%- if has_real_product -%}
        {%- form 'product', product, id: 'pj-pdp-form', class: 'pj-pdp__form', data-pdp-form: '', data-real-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="pj-pdp__field">
              <label for="pj-pdp-variant" class="pj-pdp__label">{{ product.options | join: ' / ' }}</label>
              <select id="pj-pdp-variant" name="id" class="pj-pdp__input" data-pdp-metal>
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" data-variant-title="{{ variant.title | escape }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endunless -%}

          <fieldset class="pj-pdp__birth">
            <legend class="pj-pdp__legend">
              <span class="pj-pdp__legend-title">Enter Birth Details</span>
              <span class="pj-pdp__legend-sub">Required before adding to bag. Our astrologer requires your birth date, exact time, city and country of birth.</span>
            </legend>

            <div class="pj-pdp__birth-grid">
              <div class="pj-pdp__field">
                <label for="pj-pdp-date" class="pj-pdp__label">Date of Birth <span class="pj-pdp__req">*</span></label>
                <input type="date" id="pj-pdp-date" name="properties[Birth Date]" class="pj-pdp__input" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-time" class="pj-pdp__label">Time of Birth <span class="pj-pdp__req">*</span></label>
                <input type="time" id="pj-pdp-time" name="properties[Birth Time]" class="pj-pdp__input" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-city" class="pj-pdp__label">City of Birth <span class="pj-pdp__req">*</span></label>
                <input type="text" id="pj-pdp-city" name="properties[Birth City]" class="pj-pdp__input" placeholder="e.g. Jaipur" autocomplete="off" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-country" class="pj-pdp__label">Country of Birth <span class="pj-pdp__req">*</span></label>
                <select id="pj-pdp-country" name="properties[Birth Country]" class="pj-pdp__input" required>
                  <option value="" selected disabled>Select country</option>
                  {{ all_country_option_tags }}
                </select>
              </div>
            </div>

            <label class="pj-pdp__check">
              <input type="checkbox" name="properties[Birth Time Approximate]" value="Yes">
              <span>My birth time is approximate</span>
            </label>
          </fieldset>

          <p class="pj-pdp__error" role="alert" hidden data-pdp-error>
            Please complete all birth details — date, time, city and country of birth — before adding to cart.
          </p>

          <button type="submit" class="pj-pdp__submit" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}
              <span>Add to Cart</span>
              <span aria-hidden="true">→</span>
            {%- else -%}
              <span>Sold Out</span>
            {%- endif -%}
          </button>

          <p class="pj-pdp__secure">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            Your birth details are saved to your item in the cart &amp; checkout
          </p>
        {%- endform -%}
      {%- else -%}
        <!-- Placeholder Product Form -->
        <form id="pj-pdp-form" class="pj-pdp__form" data-pdp-form data-placeholder-form novalidate>
          <div class="pj-pdp__field">
            <label for="pj-pdp-metal" class="pj-pdp__label">Select Precious Metal</label>
            <select id="pj-pdp-metal" name="metal" class="pj-pdp__input" data-pdp-metal>
              <option value="18k Solid Yellow Gold" selected>18k Solid Yellow Gold</option>
              <option value="18k Solid Rose Gold">18k Solid Rose Gold</option>
              <option value="18k Solid White Gold">18k Solid White Gold</option>
              <option value="Platinum 950">Platinum 950</option>
            </select>
          </div>

          <fieldset class="pj-pdp__birth">
            <legend class="pj-pdp__legend">
              <span class="pj-pdp__legend-title">Enter Birth Details</span>
              <span class="pj-pdp__legend-sub">Required before adding to bag. Our astrologer requires your birth date, exact time, city and country of birth.</span>
            </legend>

            <div class="pj-pdp__birth-grid">
              <div class="pj-pdp__field">
                <label for="pj-pdp-date" class="pj-pdp__label">Date of Birth <span class="pj-pdp__req">*</span></label>
                <input type="date" id="pj-pdp-date" name="birth_date" class="pj-pdp__input" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-time" class="pj-pdp__label">Time of Birth <span class="pj-pdp__req">*</span></label>
                <input type="time" id="pj-pdp-time" name="birth_time" class="pj-pdp__input" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-city" class="pj-pdp__label">City of Birth <span class="pj-pdp__req">*</span></label>
                <input type="text" id="pj-pdp-city" name="birth_city" class="pj-pdp__input" placeholder="e.g. Jaipur" autocomplete="off" required>
              </div>

              <div class="pj-pdp__field">
                <label for="pj-pdp-country" class="pj-pdp__label">Country of Birth <span class="pj-pdp__req">*</span></label>
                <select id="pj-pdp-country" name="birth_country" class="pj-pdp__input" required>
                  <option value="" selected disabled>Select country</option>
                  {{ all_country_option_tags }}
                </select>
              </div>
            </div>

            <label class="pj-pdp__check">
              <input type="checkbox" name="birth_time_approx" value="Yes">
              <span>My birth time is approximate</span>
            </label>
          </fieldset>

          <p class="pj-pdp__error" role="alert" hidden data-pdp-error>
            Please complete all birth details — date, time, city and country of birth — before adding to cart.
          </p>

          <button type="submit" class="pj-pdp__submit">
            <span>Add to Cart</span>
            <span aria-hidden="true">→</span>
          </button>

          <p class="pj-pdp__secure">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            Your birth details are saved to your item in the cart &amp; checkout
          </p>
        </form>
      {%- endif -%}

      <div class="pj-pdp__accordions">
        <details class="pj-pdp__acc" open>
          <summary>What's Included</summary>
          <div class="pj-pdp__acc-body">{{ included_text | default: 'Your chosen fine jewelry design, a natural gemstone prescribed from your birth details (date, time, city and country) by our Vedic astrologer, a personal prescription card explaining your stone and its meaning, and signature Prescribed Jewels packaging.' }}</div>
        </details>
        <details class="pj-pdp__acc">
          <summary>The Prescription &amp; Timeline</summary>
          <div class="pj-pdp__acc-body">{{ timeline_text | default: 'Day 0 — Order placed with your birth date, time, city and country. Days 1–5 — Our astrologer prescribes your gemstone. Days 3–7 — Your gemstone and its meaning are revealed by email. Weeks 5–7 — Your jewel is crafted, quality-checked and delivered.' }}</div>
        </details>
        <details class="pj-pdp__acc">
          <summary>Shipping &amp; Care</summary>
          <div class="pj-pdp__acc-body">{{ shipping_text | default: 'Insured worldwide shipping with tracking. Store your piece in its signature box, avoid perfumes and harsh chemicals, and wipe gently with a soft lint-free cloth after wear.' }}</div>
        </details>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const scripts = document.querySelectorAll('script');
    const currentScript = document.currentScript || scripts[scripts.length - 1];
    const root = currentScript.closest('.pj-pdp') || document;
    const pdpRoot = root.querySelector('[data-pdp-root]');
    const hasRealProduct = pdpRoot && pdpRoot.getAttribute('data-has-real-product') === 'true';

    const designImages = [
      {{ 'design-01-classic.jpg' | asset_url | json }},
      {{ 'design-02-solace.jpg' | asset_url | json }},
      {{ 'design-03-balance.jpg' | asset_url | json }},
      {{ 'design-04-aura.jpg' | asset_url | json }},
      {{ 'design-05-signet.jpg' | asset_url | json }},
      {{ 'design-06-celestial.jpg' | asset_url | json }},
      {{ 'design-07-bespoke.jpg' | asset_url | json }}
    ];

    const catalog = {
      'the-classic': {
        idx: 0,
        title: 'The Classic — Signature Ring',
        price: '$2,400',
        desc: '<p>A timeless solitaire silhouette in solid 18k gold, designed to be worn every day. The centre stone is not chosen from a menu — it is prescribed for you from your date, time, city and country of birth.</p>'
      },
      'the-solace': {
        idx: 1,
        title: 'The Solace — Signature Pendant',
        price: '$2,100',
        desc: '<p>An intimate everyday pendant worn close to the heart, set in solid gold with the single natural gemstone prescribed by our Vedic astrologer from your date, time, city and country of birth.</p>'
      },
      'the-balance': {
        idx: 2,
        title: 'The Balance — Signature Bracelet',
        price: '$2,650',
        desc: '<p>A refined gold bracelet balanced around your prescribed natal gemstone, crafted for effortless everyday wear and accompanied by your personal gemstone prescription.</p>'
      },
      'the-aura': {
        idx: 3,
        title: 'The Aura — Signature Drop Earrings',
        price: '$2,800',
        desc: '<p>Luminous drop earrings pairing architectural goldwork with your personally prescribed gemstone, selected from your birth date, time, city and country.</p>'
      },
      'the-signet': {
        idx: 4,
        title: 'The Signet — Signature Crest Ring',
        price: '$2,950',
        desc: '<p>A modern heirloom signet ring in solid gold, centering the natural gemstone prescribed from your natal birth chart.</p>'
      },
      'the-celestial': {
        idx: 5,
        title: 'The Celestial — Signature Medallion',
        price: '$3,100',
        desc: '<p>A sculptural talisman medallion inspired by celestial geometry, holding the natural gemstone prescribed from your birth details.</p>'
      },
      'custom-bespoke': {
        idx: 6,
        title: 'Custom — Bespoke Commission',
        price: 'By Consultation',
        desc: '<p>A one-of-a-kind bespoke creation tailored around your prescribed gemstone and personal silhouette preferences, crafted in 5–7 weeks.</p>'
      }
    };

    const applyDesignBySlug = (slug) => {
      if (hasRealProduct) return;
      const item = catalog[slug];
      if (!item) return;

      const titleEl = root.querySelector('[data-pdp-title]');
      const crumbEl = root.querySelector('[data-pdp-crumb-title]');
      const priceEl = root.querySelector('[data-pdp-price]');
      const descEl = root.querySelector('[data-pdp-desc]');
      const mainImg = root.querySelector('[data-pdp-main-img]');

      if (titleEl) titleEl.textContent = item.title;
      if (crumbEl) crumbEl.textContent = item.title;
      if (priceEl) priceEl.textContent = item.price;
      if (descEl) descEl.innerHTML = item.desc;
      if (mainImg) {
        mainImg.src = designImages[item.idx];
        mainImg.alt = item.title;
      }
    };

    const detectSlugFromLocation = () => {
      const p = window.location.pathname.toLowerCase();
      for (const key of Object.keys(catalog)) {
        if (p.includes(key)) return key;
      }
      return null;
    };

    const initialSlug = detectSlugFromLocation();
    if (initialSlug) {
      applyDesignBySlug(initialSlug);
    }

    const slides = root.querySelectorAll('[data-pdp-slide]');
    const thumbs = root.querySelectorAll('[data-pdp-thumb]');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const i = thumb.dataset.pdpThumb;
        slides.forEach((sl) => sl.classList.toggle('is-active', sl.dataset.pdpSlide === i));
        thumbs.forEach((t) => t.classList.toggle('is-active', t === thumb));
      });
    });

    const form = root.querySelector('[data-pdp-form]');
    const error = root.querySelector('[data-pdp-error]');

    if (form) {
      form.addEventListener('submit', (e) => {
        const required = Array.from(form.querySelectorAll('[required]'));
        const missing = required.filter((f) => !String(f.value || '').trim());
        required.forEach((f) => f.classList.toggle('is-invalid', missing.includes(f)));

        if (missing.length) {
          e.preventDefault();
          if (error) error.hidden = false;
          missing[0].focus();
          return;
        }

        if (error) error.hidden = true;
        e.preventDefault();

        const title = root.querySelector('[data-pdp-title]')?.textContent?.trim() || 'The Classic — Signature Ring';
        const price = root.querySelector('[data-pdp-price]')?.textContent?.trim() || '$2,400';
        const imgEl = root.querySelector('.pj-pdp__slide.is-active img') || root.querySelector('[data-pdp-main-img]');
        const image = imgEl ? imgEl.src : designImages[0];
        const metalSelect = form.querySelector('[data-pdp-metal]');
        const metal = metalSelect ? (metalSelect.options[metalSelect.selectedIndex]?.getAttribute('data-variant-title') || metalSelect.value) : '18k Solid Yellow Gold';

        const bDate = (form.querySelector('[name="birth_date"]') || form.querySelector('[name="properties[Birth Date]"]'))?.value || '';
        const bTime = (form.querySelector('[name="birth_time"]') || form.querySelector('[name="properties[Birth Time]"]'))?.value || '';
        const bCity = (form.querySelector('[name="birth_city"]') || form.querySelector('[name="properties[Birth City]"]'))?.value || '';
        const bCountry = (form.querySelector('[name="birth_country"]') || form.querySelector('[name="properties[Birth Country]"]'))?.value || '';
        const bApprox = (form.querySelector('[name="birth_time_approx"]') || form.querySelector('[name="properties[Birth Time Approximate]"]'))?.checked ? 'Yes' : 'No';

        const addItemToClientCart = (isReal) => {
          if (window.PJCart && typeof window.PJCart.addItem === 'function') {
            window.PJCart.addItem({
              title,
              price,
              image,
              url: window.location.pathname,
              metal,
              quantity: 1,
              isRealShopifyVariant: isReal,
              properties: {
                'Birth Date': bDate,
                'Birth Time': bTime,
                'Birth City': bCity,
                'Birth Country': bCountry,
                'Birth Time Approximate': bApprox
              }
            });
          }
        };

        if (form.hasAttribute('data-real-product-form')) {
          const formData = new FormData(form);
          fetch('/cart/add.js', {
            method: 'POST',
            body: formData
          })
            .then(() => addItemToClientCart(true))
            .catch(() => addItemToClientCart(false));
        } else {
          addItemToClientCart(false);
        }
      });

      form.addEventListener('input', (e) => {
        if (e.target.classList.contains('is-invalid') && String(e.target.value).trim()) {
          e.target.classList.remove('is-invalid');
        }
      });
    }
  })();
</script>
