{%- liquid
  assign s = section.settings
  assign text_color = s.text_color | default: '#F4EBE1'
  assign accent_color = s.accent_color | default: '#B69156'
  assign bg_scrolled = s.bg_color_scrolled | default: '#120E0A'
-%}

{%- if s.overlay_hero -%}
<style>
  @media (min-width: 900px) {
    .template-index .pj-header--overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
    }
    .template-index .pj-header--overlay.is-scrolled {
      position: fixed;
    }
    .template-index .pj-hero {
      height: var(--pj-hero-h, 100vh);
      padding-top: calc(var(--pj-hdr-py, 18px) * 2 + 36px);
    }
  }
</style>
{%- endif -%}

<header
  class="pj-header{% if s.overlay_hero %} pj-header--overlay{% endif %}{% if s.enable_sticky %} pj-header--sticky{% endif %}"
  data-sticky-header
  style="
    --pj-hdr-text: {{ text_color }};
    --pj-hdr-accent: {{ accent_color }};
    --pj-hdr-bg-scrolled: {{ bg_scrolled }};
    --pj-hdr-bg-opacity: {{ s.bg_opacity_scrolled | default: 85 | divided_by: 100.0 }};
    --pj-hdr-py: {{ s.header_padding_y | default: 18 }}px;
    --pj-hdr-max-w: {{ s.max_width | default: 1400 }}px;
    --pj-hdr-logo-size: {{ s.logo_font_size | default: 100 | divided_by: 100.0 }};
    --pj-hdr-logo-spacing: {{ s.logo_letter_spacing | default: 18 | divided_by: 100.0 }}em;
    --pj-hdr-nav-size: {{ s.nav_text_size | default: 100 | divided_by: 100.0 }};
    --pj-hdr-nav-gap: {{ s.nav_spacing | default: 32 }}px;
  "
>
  <div class="pj-container pj-header__inner">
    <!-- Left: Brand Logo / Text -->
    <div class="pj-header__brand">
      <a href="{{ routes.root_url }}" class="pj-header__brand-link" aria-label="{{ shop.name | default: 'Prescribed Jewels' }}">
        {%- if s.logo != blank -%}
          {{ s.logo | image_url: width: 440 | image_tag: class: 'pj-header__logo-img', alt: shop.name }}
        {%- else -%}
          <span class="pj-header__logo-text">{{ s.logo_text | default: 'PRESCRIBED JEWELS' }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Center: Navigation Links -->
    <nav class="pj-header__nav" aria-label="Primary Navigation">
      {%- if s.menu != blank and linklists[s.menu].links.size > 0 -%}
        {%- for link in linklists[s.menu].links -%}
          <a href="{{ link.url }}" class="pj-header__link pj-header__link--{{ s.nav_case | default: 'titlecase' }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="pj-header__link pj-header__link--{{ s.nav_case | default: 'titlecase' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#pj-process" class="pj-header__link pj-header__link--titlecase">The Process</a>
        <a href="#pj-designs" class="pj-header__link pj-header__link--titlecase">The Designs</a>
        <a href="#pj-story" class="pj-header__link pj-header__link--titlecase">Our Philosophy</a>
        <a href="/blogs/journal" class="pj-header__link pj-header__link--titlecase">Journal</a>
      {%- endif -%}
    </nav>

    <!-- Right: Cart Action & Mobile Toggle -->
    <div class="pj-header__actions">
      <a
        href="{{ routes.cart_url }}"
        class="pj-header__cart-link"
        {% if s.cart_action == 'drawer' %}data-open-prescription data-design="01 — The Classic (Signature Ring)"{% endif %}
        aria-label="Shopping Cart with {{ cart.item_count }} items"
      >
        <span class="pj-header__cart-label">{{ s.cart_label | default: 'Cart' }}</span>
        {%- if s.show_cart_count -%}
          <span class="pj-header__cart-count">({{ cart.item_count }})</span>
        {%- endif -%}
      </a>

      <button
        type="button"
        class="pj-header__mobile-toggle"
        aria-expanded="false"
        aria-controls="pj-mobile-nav"
        aria-label="Toggle navigation menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M3 7h18M3 12h18M3 17h18" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="pj-mobile-nav" class="pj-mobile-nav" hidden>
    <nav class="pj-container pj-mobile-nav__inner" aria-label="Mobile Navigation">
      {%- if s.menu != blank and linklists[s.menu].links.size > 0 -%}
        {%- for link in linklists[s.menu].links -%}
          <a href="{{ link.url }}" class="pj-mobile-nav__link">{{ link.title }}</a>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="pj-mobile-nav__link">{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#pj-process" class="pj-mobile-nav__link">The Process</a>
        <a href="#pj-designs" class="pj-mobile-nav__link">The Designs</a>
        <a href="#pj-story" class="pj-mobile-nav__link">Our Philosophy</a>
        <a href="/blogs/journal" class="pj-mobile-nav__link">Journal</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="pj-mobile-nav__link pj-mobile-nav__cart">{{ s.cart_label | default: 'Cart' }} ({{ cart.item_count }})</a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "pj-section-header",
  "settings": [
    {
      "type": "header",
      "content": "Brand / Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "PRESCRIBED JEWELS"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image",
      "info": "Overrides text if uploaded"
    },
    {
      "type": "range",
      "id": "logo_font_size",
      "label": "Logo Text Size",
      "min": 70,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_letter_spacing",
      "label": "Logo Letter Spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "em",
      "default": 18,
      "info": "18 = 0.18em"
    },
    {
      "type": "header",
      "content": "Navigation Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "info": "Select a Shopify navigation menu or use the blocks below"
    },
    {
      "type": "select",
      "id": "nav_case",
      "label": "Menu Text Case",
      "options": [
        { "value": "titlecase", "label": "Title Case (e.g. The Process)" },
        { "value": "uppercase", "label": "Uppercase (e.g. THE PROCESS)" },
        { "value": "normal", "label": "As Entered" }
      ],
      "default": "titlecase"
    },
    {
      "type": "range",
      "id": "nav_text_size",
      "label": "Menu Text Size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "nav_spacing",
      "label": "Space Between Links",
      "min": 14,
      "max": 54,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Cart"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart Label",
      "default": "Cart"
    },
    {
      "type": "checkbox",
      "id": "show_cart_count",
      "label": "Show Item Count",
      "default": true
    },
    {
      "type": "select",
      "id": "cart_action",
      "label": "Cart Click Action",
      "options": [
        { "value": "drawer", "label": "Open Prescription Drawer" },
        { "value": "page", "label": "Go to Cart Page" }
      ],
      "default": "drawer"
    },
    {
      "type": "header",
      "content": "Header Layout & Colors"
    },
    {
      "type": "checkbox",
      "id": "overlay_hero",
      "label": "Overlay Transparently on Hero Banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky Header on Scroll",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4EBE1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover / Accent Color",
      "default": "#B69156"
    },
    {
      "type": "color",
      "id": "bg_color_scrolled",
      "label": "Background Color (When Scrolled)",
      "default": "#120E0A"
    },
    {
      "type": "range",
      "id": "bg_opacity_scrolled",
      "label": "Background Opacity (When Scrolled)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "range",
      "id": "header_padding_y",
      "label": "Vertical Padding",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Container Max Width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Menu Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "The Process"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
