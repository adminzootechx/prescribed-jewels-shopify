{%- assign hs = section.settings -%}
{%- assign scrolled_opacity = hs.bg_opacity_scrolled | default: 60 | divided_by: 100.0 -%}
{%- assign scrolled_bg = hs.bg_color_scrolled | default: '#120E0A' -%}
{%- assign scrolled_rgba = scrolled_bg | color_modify: 'alpha', scrolled_opacity -%}

{%- assign hero_bg_color = hs.bg_color_hero | default: '#120E0A' -%}
{%- assign hero_opacity_val = hs.bg_opacity_hero | default: 55 -%}
{%- assign hero_opacity = hero_opacity_val | divided_by: 100.0 -%}
{%- assign hero_rgba = hero_bg_color | color_modify: 'alpha', hero_opacity -%}
{%- assign hero_text_color = hs.text_color_hero | default: '#E9D2AF' -%}

{%- if hs.custom_font != blank -%}<style>{{ hs.custom_font | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- assign custom_fam = hs.custom_font.family | append: ', ' | append: hs.custom_font.fallback_families -%}
{%- capture logo_font_css -%}{%- if hs.logo_font == 'custom' -%}font-family: {{ custom_fam }};{%- endif -%}{%- endcapture -%}
{%- capture nav_font_css -%}{%- if hs.nav_font == 'custom' -%}font-family: {{ custom_fam }};{%- endif -%}{%- endcapture -%}
{%- capture cart_font_css -%}{%- if hs.cart_font == 'custom' -%}font-family: {{ custom_fam }};{%- endif -%}{%- endcapture -%}
{%- assign logo_font_cls = hs.logo_font | default: 'serif' -%}
{%- assign nav_font_cls = hs.nav_font | default: 'sans' -%}
{%- assign cart_font_cls = hs.cart_font | default: 'sans' -%}
{%- assign nav_case_cls = hs.nav_case | default: 'titlecase' -%}

{%- if hs.overlay_hero -%}
<style>
  .template-index .pj-header {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    transition: background-color 0.35s ease, backdrop-filter 0.35s ease, -webkit-backdrop-filter 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }
  .template-index .pj-header:not(.is-scrolled) {
    background-color: {{ hero_rgba }} !important;
    background-color: color-mix(in srgb, {{ hero_bg_color }} {{ hero_opacity_val }}%, transparent) !important;
    backdrop-filter: blur(14px) !important;
    -webkit-backdrop-filter: blur(14px) !important;
    border-bottom: 1px solid rgba(244, 235, 225, 0.08) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25) !important;
  }
  .template-index .pj-header:not(.is-scrolled) .pj-header__wordmark,
  .template-index .pj-header:not(.is-scrolled) .pj-header__logo-text,
  .template-index .pj-header:not(.is-scrolled) .pj-header__link,
  .template-index .pj-header:not(.is-scrolled) .pj-header__cart-link,
  .template-index .pj-header:not(.is-scrolled) .pj-header__mobile-toggle {
    color: {{ hero_text_color }} !important;
  }
  .template-index .pj-header.is-scrolled {
    background-color: {{ scrolled_rgba }} !important;
    background-color: color-mix(in srgb, {{ scrolled_bg }} {{ hs.bg_opacity_scrolled | default: 60 }}%, transparent) !important;
    backdrop-filter: blur(14px) !important;
    -webkit-backdrop-filter: blur(14px) !important;
    border-bottom: 1px solid rgba(244, 235, 225, 0.1) !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35) !important;
  }
  .template-index .pj-header.is-scrolled .pj-header__wordmark,
  .template-index .pj-header.is-scrolled .pj-header__logo-text,
  .template-index .pj-header.is-scrolled .pj-header__link,
  .template-index .pj-header.is-scrolled .pj-header__cart-link,
  .template-index .pj-header.is-scrolled .pj-header__mobile-toggle {
    color: {{ hs.text_color | default: '#E9D2AF' }} !important;
  }
  .template-index .pj-header:has(#pj-mobile-nav:not([hidden])) {
    background-color: {{ scrolled_bg }} !important;
  }
  .template-index .pj-hero {
    height: var(--pj-hero-h, 100vh);
    height: var(--pj-hero-dvh, var(--pj-hero-h, 100vh));
    padding-top: calc(var(--pj-hdr-py, 18px) * 2 + 36px);
  }
  @media (max-width: 768px) {
    .template-index .pj-hero {
      height: var(--pj-hero-mobile-h, var(--pj-hero-h, 100vh));
      height: var(--pj-hero-mobile-dvh, var(--pj-hero-dvh, var(--pj-hero-mobile-h, 100dvh)));
    }
  }
</style>
{%- endif -%}

<header
  class="pj-header{% if hs.overlay_hero %} pj-header--overlay{% endif %}{% if hs.enable_sticky %} pj-header--sticky{% endif %}"
  data-sticky-header
  style="
    --pj-hdr-text: {{ hs.text_color | default: '#e9d2af' }};
    --pj-hdr-text-dark: {{ hs.text_color | default: '#e9d2af' }};
    --pj-hdr-text-light: {{ hs.text_color_light | default: '#2b241c' }};
    --pj-hdr-accent: {{ hs.accent_color | default: '#f0e4d1' }};
    --pj-hdr-bg-scrolled: {{ hs.bg_color_scrolled | default: '#120e0a' }};
    --pj-hdr-bg-scrolled-rgba: {{ scrolled_rgba }};
    --pj-hdr-bar-dark: {{ hs.bg_color_scrolled | default: '#120e0a' }};
    --pj-hdr-bar-light: {{ hs.bar_color_light | default: '#f3ece0' }};
    --pj-hdr-bg-opacity: {{ hs.bg_opacity_scrolled | default: 85 | divided_by: 100.0 }};
    --pj-hdr-py: {{ hs.header_padding_y | default: 18 }}px;
    --pj-hdr-px: {{ hs.header_padding_x | default: 15 }}px;
    --pj-hdr-max-w: {% if hs.full_width or hs.full_width == nil %}100%{% else %}{{ hs.max_width | default: 1400 }}px{% endif %};
    --pj-hdr-logo-size: {{ hs.logo_font_size | default: 100 | divided_by: 100.0 }};
    --pj-hdr-logo-spacing: {{ hs.logo_letter_spacing | default: 22 | divided_by: 100.0 }}em;
    --pj-hdr-logo-sub-spacing: {{ hs.logo_sub_letter_spacing | default: 44 | divided_by: 100.0 }}em;
    --pj-hdr-logo-sub-ratio: {{ hs.logo_sub_ratio | default: 44 | divided_by: 100.0 }};
    --pj-hdr-nav-size: {{ hs.nav_text_size | default: 110 | divided_by: 100.0 }};
    --pj-hdr-nav-spacing: {{ hs.nav_letter_spacing | default: 6 | divided_by: 100.0 }}em;
    --pj-hdr-nav-gap: {{ hs.nav_spacing | default: 34 }}px;
    --pj-hdr-cart-size: {{ hs.cart_text_size | default: 110 | divided_by: 100.0 }};
  "
>
  <div class="pj-container pj-header__inner">
    <div class="pj-header__brand">
      <a href="{{ routes.root_url }}" class="pj-header__brand-link" aria-label="{{ shop.name | default: 'Prescribed Jewels' }}">
        {%- if hs.logo_image != blank -%}
          {{ hs.logo_image | image_url: width: 400 | image_tag: class: 'pj-header__logo-img', widths: '200, 400', alt: shop.name, loading: 'eager' }}
        {%- elsif hs.logo_layout == 'stacked' -%}
          <span class="pj-header__wordmark pj-header__wordmark--{{ logo_font_cls }}" style="{{ logo_font_css }}">
            <span class="pj-header__wordmark-main">{{ hs.logo_text_main | default: 'PRESCRIBED' }}</span>
            <span class="pj-header__wordmark-sub">{{ hs.logo_text_sub | default: 'JEWELS' }}</span>
          </span>
        {%- else -%}
          <span class="pj-header__logo-text pj-header__logo-text--{{ logo_font_cls }}" style="{{ logo_font_css }}">{{ hs.logo_text | default: 'PRESCRIBED JEWELS' }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="pj-header__nav pj-header__nav--{{ nav_font_cls }}" style="{{ nav_font_css }}" aria-label="Primary Navigation">
      {%- if hs.menu != blank and hs.menu.links.size > 0 -%}
        {%- for link in hs.menu.links -%}
          <a href="{{ link.url }}" class="pj-header__link pj-header__link--{{ nav_case_cls }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="pj-header__link pj-header__link--{{ nav_case_cls }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#pj-process" class="pj-header__link pj-header__link--{{ nav_case_cls }}">The Process</a>
        <a href="#pj-designs" class="pj-header__link pj-header__link--{{ nav_case_cls }}">The Designs</a>
        <a href="#pj-story" class="pj-header__link pj-header__link--{{ nav_case_cls }}">Our Philosophy</a>
        <a href="/blogs/journal" class="pj-header__link pj-header__link--{{ nav_case_cls }}">Journal</a>
      {%- endif -%}
    </nav>

    <div class="pj-header__actions">
      <a
        href="{{ routes.cart_url }}"
        class="pj-header__cart-link pj-header__cart-link--{{ cart_font_cls }}"
        style="{{ cart_font_css }}"
        {% if hs.cart_action == 'drawer' %}data-open-prescription data-design="01 — The Classic (Signature Ring)"{% endif %}
        aria-label="Shopping Cart with {{ cart.item_count }} items"
      >
        <span class="pj-header__cart-label">{{ hs.cart_label | default: 'Cart' }}</span>
        {%- if hs.show_cart_count -%}
          <span class="pj-header__cart-count">({{ cart.item_count }})</span>
        {%- endif -%}
      </a>

      <button type="button" class="pj-header__mobile-toggle" aria-expanded="false" aria-controls="pj-mobile-nav" aria-label="Toggle navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 7h18M3 12h18M3 17h12" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div id="pj-mobile-nav" class="pj-mobile-nav" hidden>
    <nav class="pj-container pj-mobile-nav__inner" aria-label="Mobile Navigation">
      {%- if hs.menu != blank and hs.menu.links.size > 0 -%}
        {%- for link in hs.menu.links -%}
          <a href="{{ link.url }}" class="pj-mobile-nav__link">{{ link.title }}</a>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="pj-mobile-nav__link">{{ block.settings.label }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#pj-process" class="pj-mobile-nav__link">The Process</a>
        <a href="#pj-designs" class="pj-mobile-nav__link">The Designs</a>
        <a href="#pj-story" class="pj-mobile-nav__link">Our Philosophy</a>
        <a href="/blogs/journal" class="pj-mobile-nav__link">Journal</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="pj-mobile-nav__link pj-mobile-nav__cart">{{ hs.cart_label | default: 'Cart' }}{% if hs.show_cart_count %} ({{ cart.item_count }}){% endif %}</a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "pj-section-header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo image", "info": "Optional. Replaces the text logo." },
    { "type": "select", "id": "logo_layout", "label": "Logo layout", "options": [{ "value": "inline", "label": "One line" }, { "value": "stacked", "label": "Two lines" }], "default": "stacked" },
    { "type": "text", "id": "logo_text", "label": "Logo text (one line)", "default": "PRESCRIBED JEWELS" },
    { "type": "text", "id": "logo_text_main", "label": "Top line (two lines)", "default": "PRESCRIBED" },
    { "type": "text", "id": "logo_text_sub", "label": "Bottom line (two lines)", "default": "JEWELS" },
    { "type": "select", "id": "logo_font", "label": "Logo font", "options": [{ "value": "serif", "label": "Theme serif" }, { "value": "sans", "label": "Theme sans" }, { "value": "custom", "label": "Custom font (below)" }], "default": "serif" },
    { "type": "range", "id": "logo_font_size", "label": "Logo size", "min": 60, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "logo_letter_spacing", "label": "Logo letter spacing", "min": 0, "max": 60, "step": 1, "default": 22 },
    { "type": "range", "id": "logo_sub_letter_spacing", "label": "Bottom line letter spacing", "min": 0, "max": 80, "step": 1, "default": 44 },
    { "type": "range", "id": "logo_sub_ratio", "label": "Bottom line size", "min": 20, "max": 100, "step": 2, "unit": "%", "default": 44 },

    { "type": "header", "content": "Links" },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Leave empty to use the link blocks below." },
    { "type": "select", "id": "nav_font", "label": "Link font", "options": [{ "value": "serif", "label": "Theme serif" }, { "value": "sans", "label": "Theme sans" }, { "value": "custom", "label": "Custom font (below)" }], "default": "sans" },
    { "type": "select", "id": "nav_case", "label": "Link letter case", "options": [{ "value": "titlecase", "label": "Capitalised" }, { "value": "uppercase", "label": "UPPERCASE" }, { "value": "normal", "label": "As typed" }], "default": "titlecase" },
    { "type": "range", "id": "nav_text_size", "label": "Link size", "min": 70, "max": 200, "step": 5, "unit": "%", "default": 110 },
    { "type": "range", "id": "nav_letter_spacing", "label": "Link letter spacing", "min": 0, "max": 40, "step": 1, "default": 6 },
    { "type": "range", "id": "nav_spacing", "label": "Space between links", "min": 10, "max": 90, "step": 2, "unit": "px", "default": 34 },

    { "type": "header", "content": "Cart" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "Cart" },
    { "type": "checkbox", "id": "show_cart_count", "label": "Show item count", "default": true },
    { "type": "select", "id": "cart_font", "label": "Cart font", "options": [{ "value": "serif", "label": "Theme serif" }, { "value": "sans", "label": "Theme sans" }, { "value": "custom", "label": "Custom font (below)" }], "default": "sans" },
    { "type": "range", "id": "cart_text_size", "label": "Cart size", "min": 70, "max": 200, "step": 5, "unit": "%", "default": 110 },
    { "type": "select", "id": "cart_action", "label": "Cart opens", "options": [{ "value": "drawer", "label": "Drawer" }, { "value": "page", "label": "Cart page" }], "default": "page", "info": "The cart page is used until a cart drawer is added to the theme." },

    { "type": "header", "content": "Custom font" },
    { "type": "font_picker", "id": "custom_font", "label": "Custom font", "default": "jost_n4", "info": "Used by any element above set to Custom font." },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Text on dark sections", "default": "#E9D2AF" },
    { "type": "color", "id": "text_color_light", "label": "Text on light sections", "default": "#2B241C" },
    { "type": "color", "id": "accent_color", "label": "Link hover colour", "default": "#B69156" },

    { "type": "header", "content": "Behaviour and bar" },
    { "type": "checkbox", "id": "full_width", "label": "Full width (align to screen edges)", "default": true },
    { "type": "range", "id": "header_padding_x", "label": "Side padding (Left & Right)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 15, "info": "Distance from the left and right screen edges." },
    { "type": "checkbox", "id": "overlay_hero", "label": "Sit over the top of the page", "default": true, "info": "The first section starts behind the bar." },
    { "type": "checkbox", "id": "enable_sticky", "label": "Stay visible while scrolling", "default": true },
    { "type": "color", "id": "bg_color_hero", "label": "Hero bar background colour", "default": "#120E0A" },
    { "type": "range", "id": "bg_opacity_hero", "label": "Hero bar background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "0% is transparent, 100% is solid." },
    { "type": "color", "id": "text_color_hero", "label": "Hero bar text colour", "default": "#E9D2AF" },
    { "type": "color", "id": "bg_color_scrolled", "label": "Bar colour over dark sections", "default": "#120E0A" },
    { "type": "color", "id": "bar_color_light", "label": "Bar colour over light sections", "default": "#F3ECE0" },
    { "type": "range", "id": "bg_opacity_scrolled", "label": "Bar strength after scrolling", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60, "info": "0% is fully transparent." },
    { "type": "range", "id": "header_padding_y", "label": "Bar height padding", "min": 6, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 960, "max": 1920, "step": 20, "unit": "px", "default": 1400 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Menu link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Jewels" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
