<header class="pj-header" data-sticky-header>
  <div class="pj-container pj-header__inner">
    <button
      type="button"
      class="pj-header__mobile-toggle"
      aria-expanded="false"
      aria-controls="pj-mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
        <path d="M3 7h18M3 12h18M3 17h12" stroke-linecap="round"/>
      </svg>
    </button>

    <nav class="pj-header__nav" aria-label="Primary Navigation">
      <a href="#pj-designs" class="pj-header__link">Jewels</a>
      <a href="#pj-story" class="pj-header__link">Our Story</a>
      <a href="#pj-process" class="pj-header__link">The Prescription</a>
    </nav>

    <a href="{{ routes.root_url }}" class="pj-header__logo" aria-label="{{ shop.name | default: 'Prescribed Jewels' }}">
      {% render 'pj-monogram', variant: 'wordmark' %}
    </a>

    <div class="pj-header__actions">
      <a href="#pj-gemstones" class="pj-header__icon-link" aria-label="Explore Gemstones">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
          <circle cx="11" cy="11" r="7"/>
          <path d="M20 20l-3.5-3.5" stroke-linecap="round"/>
        </svg>
      </a>

      <button
        type="button"
        class="pj-header__icon-link pj-header__icon-btn"
        data-open-prescription
        data-design="01 — The Classic (Signature Ring)"
        aria-label="Begin Your Prescription"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
          <circle cx="12" cy="8" r="4"/>
          <path d="M5 20c1.5-3.5 4-5 7-5s5.5 1.5 7 5" stroke-linecap="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="pj-header__icon-link pj-header__icon-btn"
        data-open-prescription
        data-design="01 — The Classic (Signature Ring)"
        aria-label="Order Bag"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
          <path d="M6 7h12l1 13H5L6 7z" stroke-linejoin="round"/>
          <path d="M9 7V5a3 3 0 0 1 6 0v2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="pj-mobile-nav" class="pj-mobile-nav" hidden>
    <nav class="pj-container pj-mobile-nav__inner" aria-label="Mobile Navigation">
      <a href="#pj-designs" class="pj-mobile-nav__link">Jewels</a>
      <a href="#pj-story" class="pj-mobile-nav__link">Our Story</a>
      <a href="#pj-process" class="pj-mobile-nav__link">The Prescription</a>
      <a href="#pj-gemstones" class="pj-mobile-nav__link">Gemstones</a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "pj-section-header",
  "settings": []
}
{% endschema %}
