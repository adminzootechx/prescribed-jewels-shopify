<section id="pj-story" class="pj-story pj-section" aria-labelledby="pj-story-heading" style="--pj-hs-sec: {{ section.settings.heading_size | divided_by: 100.0 }};{% if section.settings.card_color != blank %} --pj-bg-primary: {{ section.settings.card_color }};{% endif %}">
  <div class="pj-container">
    <div class="pj-story__card">
      <div class="pj-story__monogram">
        {% render 'pj-monogram', variant: 'monogram' %}
      </div>
      <p class="pj-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="pj-story-heading" class="pj-story__title">
        {{ section.settings.heading }}
      </h2>
      <p class="pj-story__text">
        {{ section.settings.body_text }}
      </p>
      <div class="pj-story__cta">
        <button
          type="button"
          class="pj-btn pj-btn--primary"
          data-open-prescription
          data-design="01 — The Classic (Signature Ring)"
        >
          <span>{{ section.settings.button_label }}</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "5. Our Story",
  "tag": "section",
  "class": "pj-section-story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Piece of Your Own Story"
    },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 60, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "BEGIN YOUR PRESCRIPTION" },
    { "type": "color", "id": "card_color", "label": "Card color", "info": "Leave empty to use the theme background." },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "Prescribed Jewels is born from the belief that fine jewellery should carry personal meaning — uniting modern silhouettes with a single natural gemstone prescribed from your Vedic birth details."
    }
  ],
  "presets": [
    {
      "name": "5. Our Story"
    }
  ]
}
{% endschema %}
