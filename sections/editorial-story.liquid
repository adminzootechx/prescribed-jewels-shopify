{%- assign s = section.settings -%}
{% render 'pj-section-style', section: section %}

<section
  id="pj-story"
  class="pj-story pj-section pj-story--{{ s.align }}{% if s.show_card %} pj-story--has-card{% endif %}"
  aria-labelledby="pj-story-heading"
  style="--pj-hs-sec: {{ s.heading_size | divided_by: 100.0 }}; --pj-story-veil: {{ s.veil }}%; --pj-story-veil-color: {{ s.veil_color | default: '#2A1C10' }}; --pj-story-min: {{ s.min_height }}px; {% if s.section_height > 0 %}--pj-story-h: {{ s.section_height }}vh; {% endif %}--pj-story-pt: {{ s.padding_top | default: 64 }}px; --pj-story-pb: {{ s.padding_bottom | default: 64 }}px; --pj-story-card-max-w: {{ s.card_max_width | default: 1080 }}px; --pj-story-focus: {{ s.focus_x }}% {{ s.focus_y }}%;{% if s.card_color != blank %} --pj-story-card-bg: {{ s.card_color }};{% endif %}"
>
  <div class="pj-story__bg" aria-hidden="true">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 2400 | image_tag: class: 'pj-story__bg-img', widths: '1200, 1800, 2400', sizes: '100vw', alt: s.heading, loading: 'lazy' }}
    {%- else -%}
      <img class="pj-story__bg-img" src="{{ 'story-jewels-silk.png' | asset_url }}" alt="Prescribed Jewels silk drape with gold necklace and rings" width="1920" height="1080" loading="lazy">
    {%- endif -%}
  </div>

  <div class="pj-container pj-story__layout">
    <div class="pj-story__card">
      {%- if s.show_monogram -%}
        <div class="pj-story__monogram">
          {% render 'pj-monogram', variant: 'monogram' %}
        </div>
      {%- endif -%}
      <p class="pj-eyebrow">{{ s.eyebrow }}</p>
      <h2 id="pj-story-heading" class="pj-story__title">
        {{ s.heading }}
      </h2>
      <p class="pj-story__text">
        {{ s.body_text }}
      </p>
      <div class="pj-story__cta">
        <button
          type="button"
          class="pj-btn pj-btn--primary"
          data-open-prescription
          data-design="01 — The Classic (Signature Ring)"
        >
          <span>{{ s.button_label }}</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "5. Our Story",
  "tag": "section",
  "class": "pj-section-story",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR STORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Piece of Your Own Story" },
    { "type": "textarea", "id": "body_text", "label": "Body Text", "default": "Prescribed Jewels is born from the belief that fine jewellery should carry personal meaning — uniting modern silhouettes with a single natural gemstone prescribed from your Vedic birth details." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "BEGIN YOUR PRESCRIPTION" },
    { "type": "checkbox", "id": "show_monogram", "label": "Show the PJ monogram", "default": true },
    { "type": "checkbox", "id": "show_card", "label": "Show framed card over image", "default": true, "info": "When on, frames text inside an elegant ivory card over the jewelry photo (as in design preview)." },

    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Leave empty to use the built-in silk drape with gold necklace and rings." },
    { "type": "range", "id": "focus_x", "label": "Image focus, across", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_y", "label": "Image focus, down", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "color", "id": "veil_color", "label": "Tint over the image", "default": "#2A1C10" },
    { "type": "range", "id": "veil", "label": "Tint strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 20, "info": "Raise it if you want the background photo darker." },

    { "type": "header", "content": "Layout, Spacing & Screen Fit" },
    { "type": "select", "id": "align", "label": "Text position", "default": "center", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },
    { "type": "range", "id": "section_height", "label": "Section Min Height (Screen Fit)", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 0, "info": "0 = Auto fit content. 100 = 100vh full screen fit." },
    { "type": "range", "id": "min_height", "label": "Minimum pixel height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 10, "max": 180, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 10, "max": 180, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "card_max_width", "label": "Framed Card Max Width", "min": 600, "max": 1200, "step": 20, "unit": "px", "default": 1080 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "card_color", "label": "Card background color", "info": "Leave empty for translucent warm white." },
    { "type": "color", "id": "text_color", "label": "Heading and label", "default": "#1A1815" },
    { "type": "color", "id": "muted_color", "label": "Body text", "default": "#4A4237" },
    { "type": "color", "id": "accent_color", "label": "Button background", "default": "#12261E", "info": "Fill colour of the button." },

    { "type": "header", "content": "Fonts and sizes" },
    { "type": "checkbox", "id": "use_custom_fonts", "label": "Use the fonts chosen below", "default": false, "info": "Off: the theme fonts." },
    { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "cormorant_n4" },
    { "type": "font_picker", "id": "font_body", "label": "Text font", "default": "jost_n3" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 60, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "body_size", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [
    {
      "name": "5. Our Story"
    }
  ]
}
{% endschema %}
