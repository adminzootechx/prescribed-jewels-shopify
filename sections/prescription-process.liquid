{%- assign s = section.settings -%}

<section
  id="pj-process"
  class="pj-process-steps-section"
  aria-labelledby="pj-process-heading"
  style="
    {% if s.bg_color != blank %}--pj-ps-bg: {{ s.bg_color }};{% endif %}
    --pj-ps-eyebrow-color: {{ s.eyebrow_color | default: '#B69156' }};
    --pj-ps-heading-color: {{ s.heading_color | default: '#1A1815' }};
    --pj-ps-step-num-color: {{ s.step_num_color | default: '#B69156' }};
    --pj-ps-step-title-color: {{ s.step_title_color | default: '#1A1815' }};
    --pj-ps-step-desc-color: {{ s.step_desc_color | default: '#4A4237' }};
    --pj-ps-img-border: {{ s.image_border_color | default: 'rgba(26, 24, 21, 0.12)' }};
    --pj-ps-max-w: {{ s.max_width | default: 1240 }}px;
    --pj-ps-gap: {{ s.grid_gap | default: 28 }}px;
    --pj-ps-pt: {{ s.padding_top | default: 72 }}px;
    --pj-ps-pb: {{ s.padding_bottom | default: 72 }}px;
  "
>
  <div class="pj-container pj-process-steps__container">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="pj-process-steps__header">
        {%- if s.eyebrow != blank -%}
          <p class="pj-eyebrow pj-process-steps__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 id="pj-process-heading" class="pj-process-steps__title">
            {{ s.heading | escape }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pj-process-steps__grid">
      {%- assign fallback_imgs = 'process-step-light-1.png,process-step-light-2.png,process-step-light-3.png,process-step-light-4.png' | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="pj-process-step" {{ block.shopify_attributes }}>
          <div class="pj-process-step__head">
            <span class="pj-process-step__num">{{ b.step_number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="pj-process-step__name">{{ b.title }}</h3>
          </div>

          <div class="pj-process-step__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 700 | image_tag: class: 'pj-process-step__img', widths: '350, 500, 700', sizes: '(min-width: 960px) 24vw, 85vw', alt: b.title, loading: 'lazy' }}
            {%- else -%}
              {%- assign idx = forloop.index0 | modulo: 4 -%}
              {%- assign def_img = fallback_imgs[idx] -%}
              <img src="{{ def_img | asset_url }}" alt="{{ b.title | escape }}" class="pj-process-step__img" width="500" height="500" loading="lazy">
            {%- endif -%}
          </div>

          {%- if b.description != blank -%}
            <p class="pj-process-step__desc">{{ b.description | escape }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works (4 Steps)",
  "tag": "section",
  "class": "pj-section-process",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE PROCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A PIECE THAT'S TRULY YOURS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (leave blank for theme default)"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow & Number Color",
      "default": "#B69156"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1A1815"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step Title Color",
      "default": "#1A1815"
    },
    {
      "type": "color",
      "id": "step_desc_color",
      "label": "Step Description Color",
      "default": "#4A4237"
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image Border Color",
      "default": "rgba(26, 24, 21, 0.12)"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Container Width",
      "min": 1000,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between boxes",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Share your details"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Tell us your date, time, and place of birth."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works (4 Steps)",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
