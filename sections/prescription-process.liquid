<section id="pj-process" class="pj-process-scroll-outer" aria-labelledby="pj-process-heading" data-scroll-process style="--pj-hs-sec: {{ section.settings.heading_size | divided_by: 100.0 }}; --pj-d: {{ section.settings.circle_size }}px;">
  <div class="pj-process-sticky">
    <div class="pj-container">
      <div class="pj-process__header">
        <p class="pj-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="pj-process-heading" class="pj-section-title">{{ section.settings.heading }}</h2>
      </div>

      <div class="pj-process__stage">
        <!-- Alternating Sine-Wave Curve: Arch Over (∩) Step 1 -> U-Curve Under (∪) Step 2 -> Arch Over (∩) Step 3 -> U-Curve Under (∪) Step 4 -> Arch Over (∩) Step 5 -->
        <div class="pj-process__curve-wrap" aria-hidden="true">
          <svg class="pj-process__curve-svg" viewBox="0 0 1200 360" fill="none" preserveAspectRatio="none">
            <path
              class="pj-process__curve-bg"
              d="M 10,180 C 30,20 210,20 240,180 C 270,340 450,340 480,180 C 510,20 690,20 720,180 C 750,340 930,340 960,180 C 990,20 1170,20 1190,180"
            />
            <path
              id="pj-curve-path-fill"
              class="pj-process__curve-fill"
              d="M 10,180 C 30,20 210,20 240,180 C 270,340 450,340 480,180 C 510,20 690,20 720,180 C 750,340 930,340 960,180 C 990,20 1170,20 1190,180"
            />
          </svg>
        </div>

        {%- assign fallbacks = 'design-01-classic.jpg,gemstones-editorial.jpg,design-06-celestial.jpg,design-05-signet.jpg,design-04-aura.jpg' | split: ',' -%}
        <ol class="pj-steps" aria-label="Prescription journey">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign is_top = forloop.index0 | modulo: 2
            -%}
            <li class="pj-step {% if is_top == 0 %}pj-step--arch-top{% else %}pj-step--curve-bottom{% endif %}{% if forloop.first %} is-reached{% endif %}" data-process-step="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="pj-step__card">
                <div class="pj-step__photo-wrap">
                  {%- if b.image != blank -%}
                    {{ b.image | image_url: width: 480 | image_tag: class: 'pj-step__photo', widths: '240, 360, 480', sizes: '160px', alt: b.title, loading: 'lazy' }}
                  {%- else -%}
                    <img src="{{ fallbacks[forloop.index0] | default: fallbacks[0] | asset_url }}" alt="{{ b.title | escape }}" class="pj-step__photo" width="240" height="240" loading="lazy">
                  {%- endif -%}
                  <span class="pj-step__badge">{{ forloop.index | prepend: '0' }}</span>
                </div>
                <div class="pj-step__text">
                  <span class="pj-step__num">{{ b.when }}</span>
                  <h3 class="pj-step__title">{{ b.title }}</h3>
                  <p class="pj-step__desc">{{ b.text }}</p>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "3. How It Works",
  "tag": "section",
  "class": "pj-section-process",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT WORKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A THOUGHTFUL JOURNEY" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 60, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "circle_size", "label": "Photo circle size", "min": 90, "max": 170, "step": 2, "unit": "px", "default": 136, "info": "Desktop. The route always passes through the middle of each circle." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Square. Shown as a circle." },
        { "type": "text", "id": "when", "label": "Timing", "default": "DAY 0" },
        { "type": "text", "id": "title", "label": "Title", "default": "ORDER PLACED" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Select your design and share your birth details." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "3. How It Works",
      "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" } ]
    }
  ]
}
{% endschema %}
