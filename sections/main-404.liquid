<section
  id="pj-404-fallback"
  class="pj-contact-section"
  style="--pj-contact-bg: #F3ECE0; --pj-contact-pt: 80px; --pj-contact-pb: 96px; text-align: center; display: none;"
>
  <div class="pj-container" style="max-width: 640px; margin: 0 auto;">
    <p class="pj-eyebrow">404</p>
    <h1 class="pj-section-title" style="margin-bottom: 1rem;">Page Not Found</h1>
    <p style="color: var(--pj-text-muted); margin-bottom: 2rem;">The page you are looking for may have moved or no longer exists.</p>
    <a href="{{ routes.root_url }}" class="pj-btn pj-btn--primary">Return Home →</a>
  </div>
</section>

<script>
  (() => {
    const sec = document.getElementById('pj-404-fallback');
    if (!sec) return;
    const path = window.location.pathname.toLowerCase();
    const isContact = path.includes('contact');
    const isProduct = path.includes('/products/') || path.includes('product') || path.includes('design') || path.includes('classic') || path.includes('solace') || path.includes('balance') || path.includes('aura') || path.includes('signet') || path.includes('celestial') || path.includes('bespoke');
    sec.style.display = (!isContact && !isProduct) ? '' : 'none';
  })();
</script>

{% schema %}
{
  "name": "404 Not Found Message",
  "tag": "div",
  "class": "pj-section-404",
  "settings": []
}
{% endschema %}
