{% render 'pj-section-style', section: section %}
<section
  id="pj-gemstones"
  class="pj-gemstones-wheel-outer"
  aria-labelledby="pj-gemstones-heading"
  data-gem-wheel-section
  data-arrow-start-x="{{ section.settings.arrow_start_x | default: 0 }}"
  data-arrow-start-y="{{ section.settings.arrow_start_y | default: 0 }}"
  data-arrow-end-x="{{ section.settings.arrow_end_x | default: 0 }}"
  data-arrow-end-y="{{ section.settings.arrow_end_y | default: 0 }}"
  data-arrow-lift="{{ section.settings.arrow_curvature | default: 32 }}"
  style="
    --pj-hs-sec: {{ section.settings.heading_size | default: 110 | divided_by: 100.0 }};
    --pj-w-hs: {{ section.settings.heading_size | default: 110 | divided_by: 100.0 }};
    --pj-w-veil: {{ section.settings.veil }}%;
    --pj-w-veil-color: {{ section.settings.veil_color }};
    --pj-w-text: {{ section.settings.text_color }};
    --pj-w-muted: {{ section.settings.muted_color }};
    --pj-w-bg: {{ section.settings.veil_color }};
    --pj-w-ns: {{ section.settings.notes_size | default: 120 | divided_by: 100.0 }};
    --pj-w-nts: {{ section.settings.note_title_size | default: 115 | divided_by: 100.0 }};
    --pj-w-ps: {{ section.settings.planet_size | default: 110 | divided_by: 100.0 }};
    --pj-w-minh: {{ section.settings.height | divided_by: 100.0 }};
    --pj-w-wscale: {{ section.settings.wheel_size | divided_by: 100.0 }};
    --pj-w-glow: {{ section.settings.glow_color }};
    --pj-w-glow-a: {{ section.settings.glow_strength }}%;
    --pj-w-info-x: {{ section.settings.info_offset_x | default: 0 }}px;
    --pj-w-info-y: {{ section.settings.info_offset_y | default: 0 }}px;
    --pj-w-info-w: {{ section.settings.info_width | default: 740 }}px;
    --pj-w-gem-scale: {{ section.settings.big_gem_scale | default: 100 | divided_by: 100.0 }};
    --pj-w-gem-x: {{ section.settings.big_gem_offset_x | default: 0 }}px;
    --pj-w-gem-y: {{ section.settings.big_gem_offset_y | default: 0 }}px;
    --pj-w-arrow-stroke: {{ section.settings.arrow_stroke | default: 2.6 }}px;
    {% unless section.settings.use_stone_color %}--gem-c: {{ section.settings.accent_color }};{% endunless %}
  "
  {% unless section.settings.use_stone_color %}data-fixed-accent{% endunless %}
>
  <div class="pj-gemstones-wheel-section">
    <div class="pj-wheel-bg" aria-hidden="true">
      {%- if section.settings.bg_image != blank -%}
        {{ section.settings.bg_image | image_url: width: 2400 | image_tag: class: 'pj-wheel-bg__img', widths: '800, 1400, 2000, 2400', sizes: '100vw', alt: '', loading: 'lazy' }}
      {%- else -%}
        <img src="{{ 'wheel-velvet-bg.jpg' | asset_url }}" alt="" class="pj-wheel-bg__img" width="2400" height="1350" loading="lazy">
      {%- endif -%}
    </div>
    <div class="pj-wheel-glow" aria-hidden="true"></div>
    <div class="pj-container pj-gemstones-wheel__layout">
      <!-- Curved arrow from the highlighted stone to its photograph, drawn in the stone's own colour -->
      <svg class="pj-gem-arrow" id="pj-gem-arrow" aria-hidden="true" focusable="false">
        <defs>
          <marker id="pj-arrowhead" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="11" markerHeight="11" orient="auto">
            <path d="M1 1 L10 6 L1 11" fill="none" stroke="var(--gem-c, #B69156)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
        </defs>
        <circle id="pj-gem-arrow-dot" r="5" />
        <path id="pj-gem-arrow-path" pathLength="1" marker-end="url(#pj-arrowhead)" />
      </svg>

      <!-- Left: the chosen stone, with what is known about it set out around its photograph -->
      <div class="pj-gemstones-wheel__info">
        <div class="pj-gem-diagram" id="pj-wheel-info-box" aria-live="polite">
          {%- if section.settings.show_leader_lines -%}
          <svg class="pj-gem-diagram__lines" viewBox="0 0 720 540" aria-hidden="true" focusable="false">
            <g class="pj-gem-diagram__leaders">
              <path d="M214 76 C 252 80, 272 104, 286 136" />
              <path d="M506 76 C 468 80, 448 104, 434 136" />
              <path d="M214 462 C 220 424, 230 384, 250 346" />
              <path d="M506 462 C 500 424, 490 384, 470 346" />
              <circle cx="214" cy="76" r="3.5" /><circle cx="506" cy="76" r="3.5" />
              <circle cx="214" cy="462" r="3.5" /><circle cx="506" cy="462" r="3.5" />
            </g>
          </svg>
          {%- endif -%}

          <div class="pj-gem-diagram__photo" id="pj-gem-photo-wrap">
            <img id="pj-gem-photo" class="is-cutout" src="{{ 'gemx-emerald-2.webp' | asset_url }}" alt="" width="400" height="400" decoding="async">
          </div>

          <div class="pj-gem-diagram__name">
            <p class="pj-gemstones-wheel__planet" id="pj-wheel-planet">MERCURY · BUDHA</p>
            <h2 id="pj-gemstones-heading" class="pj-gemstones-wheel__title"><span id="pj-wheel-stone-name">EMERALD</span></h2>
          </div>

          <div class="pj-gem-note pj-gem-note--tl"><h3 class="pj-gem-note__title">Features</h3><p id="pj-gem-features"></p></div>
          <div class="pj-gem-note pj-gem-note--tr"><h3 class="pj-gem-note__title">Uses</h3><p id="pj-gem-uses"></p></div>
          <div class="pj-gem-note pj-gem-note--bl"><h3 class="pj-gem-note__title">Importance</h3><p id="pj-wheel-desc">Cultivates intellect, eloquent speech, emotional composure, and clear discernment.</p></div>
          <div class="pj-gem-note pj-gem-note--br"><h3 class="pj-gem-note__title">Traditionally worn</h3><p id="pj-gem-wear"></p></div>
        </div>
      </div>

      <!-- Right Column: Half-Circle Rotating Gemstone Track -->
      <div class="pj-gemstones-wheel__stage" aria-hidden="true">
        <div class="pj-wheel-half-clip">
          <div class="pj-wheel-assembly">
            <svg class="pj-wheel-frame" viewBox="0 0 560 560" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="pj-gold-a" gradientUnits="userSpaceOnUse" x1="40" y1="40" x2="520" y2="520">
                  <stop offset="0" stop-color="#6a4915"/>
                  <stop offset="0.16" stop-color="#c8993f"/>
                  <stop offset="0.3" stop-color="#fff0b4"/>
                  <stop offset="0.46" stop-color="#d4a54a"/>
                  <stop offset="0.62" stop-color="#8a5d1c"/>
                  <stop offset="0.8" stop-color="#e9c46d"/>
                  <stop offset="1" stop-color="#5c3f12"/>
                </linearGradient>
                <linearGradient id="pj-gold-b" gradientUnits="userSpaceOnUse" x1="520" y1="40" x2="40" y2="520">
                  <stop offset="0" stop-color="#5c3f12"/>
                  <stop offset="0.2" stop-color="#e2b95f"/>
                  <stop offset="0.38" stop-color="#fff3c4"/>
                  <stop offset="0.55" stop-color="#b98a35"/>
                  <stop offset="0.75" stop-color="#f0cf80"/>
                  <stop offset="1" stop-color="#6a4915"/>
                </linearGradient>
                <radialGradient id="pj-gold-rivet" cx="0.35" cy="0.3" r="0.8">
                  <stop offset="0" stop-color="#fff6cf"/>
                  <stop offset="0.5" stop-color="#d1a444"/>
                  <stop offset="1" stop-color="#6a4915"/>
                </radialGradient>
              </defs>
              <circle cx="280" cy="280" r="270" fill="none" stroke="url(#pj-gold-a)" stroke-width="6"/>
              <circle cx="280" cy="280" r="273.5" fill="none" stroke="#fff6d2" stroke-opacity="0.55" stroke-width="1.2"/>
              <circle cx="280" cy="280" r="190" fill="none" stroke="url(#pj-gold-b)" stroke-width="5"/>
              <circle cx="280" cy="280" r="193" fill="none" stroke="#fff6d2" stroke-opacity="0.5" stroke-width="1.2"/>
              <g class="pj-wheel-frame__spin" id="pj-wheel-frame-spin">
                <path d="M314 280 L470 280 M304.04 304.04 L414.35 414.35 M280 314 L280 470 M255.96 304.04 L145.65 414.35 M246 280 L90 280 M255.96 255.96 L145.65 145.65 M280 246 L280 90 M304.04 255.96 L414.35 145.65" fill="none" stroke="url(#pj-gold-b)" stroke-width="4.5" stroke-linecap="round"/>
              </g>
              <circle cx="280" cy="280" r="34" fill="url(#pj-gold-a)"/>
              <circle cx="280" cy="280" r="34" fill="none" stroke="#fff3c4" stroke-opacity="0.6" stroke-width="1.4"/>
              <circle cx="280" cy="280" r="15" fill="url(#pj-gold-rivet)"/>
            </svg>
            <div class="pj-wheel-halo" aria-hidden="true"></div>

            <!-- Rotating Rotor carrying Gemstone Images along the Half-Circle -->
            <div
              class="pj-wheel-rotor"
              id="pj-wheel-rotor"
              data-gem-names="{%- for block in section.blocks -%}{{ block.settings.name | escape }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-descs="{%- for block in section.blocks -%}{{ block.settings.text | escape }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-features="{%- for block in section.blocks -%}{{ block.settings.features | escape }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-uses="{%- for block in section.blocks -%}{{ block.settings.uses | escape }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-wear="{%- for block in section.blocks -%}{{ block.settings.wear | escape }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-angle2="{%- for block in section.blocks -%}{%- if block.settings.angle_2 != blank -%}{{ block.settings.angle_2 | image_url: width: 900 }}{%- endif -%}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-angle3="{%- for block in section.blocks -%}{%- if block.settings.angle_3 != blank -%}{{ block.settings.angle_3 | image_url: width: 900 }}{%- endif -%}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-photos="{%- for block in section.blocks -%}{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 }}{%- endif -%}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-urls="{{ 'gemx-emerald-1.webp' | asset_url }}|{{ 'gemx-ruby-1.webp' | asset_url }}|||{{ 'gemx-diamond-1.webp' | asset_url }}|||{{ 'gemx-hessonite-1.webp' | asset_url }}|{{ 'gemx-catseye-1.webp' | asset_url }}|{{ 'gemx-moonstone-1.webp' | asset_url }}|{{ 'gemx-amethyst-1.webp' | asset_url }}|{{ 'gemx-citrine-1.webp' | asset_url }}||||||"
              data-gem-side="{{ 'gemx-emerald-3.webp' | asset_url }}|{{ 'gemx-ruby-side.webp' | asset_url }}|||{{ 'gemx-diamond-side.webp' | asset_url }}|||{{ 'gemx-hessonite-3.webp' | asset_url }}|{{ 'gemx-catseye-3.webp' | asset_url }}|{{ 'gemx-moonstone-3.webp' | asset_url }}|{{ 'gemx-amethyst-3.webp' | asset_url }}|{{ 'gemx-citrine-3.webp' | asset_url }}||||||"
              data-gem-side-own="{%- for block in section.blocks -%}{%- if block.settings.side_image != blank -%}{{ block.settings.side_image | image_url: width: 900 }}{%- endif -%}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}"
              data-gem-views="{{ 'gemx-emerald-2.webp' | asset_url }},{{ 'gemx-emerald-3.webp' | asset_url }},{{ 'gemx-emerald-4.webp' | asset_url }}|{{ 'gemx-ruby-2.webp' | asset_url }},{{ 'gemx-ruby-3.webp' | asset_url }},{{ 'gemx-ruby-4.webp' | asset_url }}|||{{ 'gemx-diamond-2.webp' | asset_url }},{{ 'gemx-diamond-3.webp' | asset_url }}|||{{ 'gemx-hessonite-2.webp' | asset_url }},{{ 'gemx-hessonite-3.webp' | asset_url }},{{ 'gemx-hessonite-4.webp' | asset_url }}|{{ 'gemx-catseye-2.webp' | asset_url }},{{ 'gemx-catseye-3.webp' | asset_url }},{{ 'gemx-catseye-4.webp' | asset_url }}|{{ 'gemx-moonstone-2.webp' | asset_url }},{{ 'gemx-moonstone-3.webp' | asset_url }},{{ 'gemx-moonstone-4.webp' | asset_url }}|{{ 'gemx-amethyst-2.webp' | asset_url }},{{ 'gemx-amethyst-3.webp' | asset_url }},{{ 'gemx-amethyst-4.webp' | asset_url }}|{{ 'gemx-citrine-2.webp' | asset_url }},{{ 'gemx-citrine-3.webp' | asset_url }},{{ 'gemx-citrine-4.webp' | asset_url }}||||||"
            >
              <!-- JS populates the gemstone images around the half-circle wheel -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "4. Rotating Gemstones",
  "tag": "section",
  "class": "pj-section-gemstones",
  "settings": [
    { "type": "header", "content": "1. Section & Wheel Size" },
    { "type": "range", "id": "height", "label": "Section height", "min": 60, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "wheel_size", "label": "Wheel size", "min": 60, "max": 130, "step": 5, "unit": "%", "default": 100 },

    { "type": "header", "content": "2. Info Box Position & Layout" },
    { "type": "range", "id": "info_offset_x", "label": "Info box position X", "min": -160, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "info_offset_y", "label": "Info box position Y", "min": -120, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "info_width", "label": "Info box max width", "min": 540, "max": 860, "step": 20, "unit": "px", "default": 740 },
    { "type": "range", "id": "big_gem_scale", "label": "Big gemstone size (%)", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "big_gem_offset_x", "label": "Big gemstone position X", "min": -60, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "big_gem_offset_y", "label": "Big gemstone position Y", "min": -60, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "show_leader_lines", "label": "Show leader lines", "default": true },

    { "type": "header", "content": "3. Arrow Position & Curvature" },
    { "type": "range", "id": "arrow_start_x", "label": "Arrow start position X (on ring)", "min": -80, "max": 80, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "arrow_start_y", "label": "Arrow start position Y (on ring)", "min": -80, "max": 80, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "arrow_end_x", "label": "Arrow end position X (into big gem)", "min": -80, "max": 80, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "arrow_end_y", "label": "Arrow end position Y (into big gem)", "min": -80, "max": 80, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "arrow_curvature", "label": "Arrow curve height (%)", "min": 10, "max": 70, "step": 2, "unit": "%", "default": 32 },
    { "type": "range", "id": "arrow_stroke", "label": "Arrow stroke thickness", "min": 1.5, "max": 5, "step": 0.5, "unit": "px", "default": 2.5 },

    { "type": "header", "content": "4. Text Sizes & Typography" },
    { "type": "range", "id": "heading_size", "label": "Stone name size (%)", "min": 60, "max": 200, "step": 5, "unit": "%", "default": 110 },
    { "type": "range", "id": "planet_size", "label": "Ruling planet size (%)", "min": 60, "max": 200, "step": 5, "unit": "%", "default": 110 },
    { "type": "range", "id": "note_title_size", "label": "Note titles size (%)", "min": 60, "max": 200, "step": 5, "unit": "%", "default": 115 },
    { "type": "range", "id": "notes_size", "label": "Note description size (%)", "min": 60, "max": 200, "step": 5, "unit": "%", "default": 120 },

    { "type": "header", "content": "5. Background & Lighting" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image", "info": "Leave blank to use the built-in dark velvet background." },
    { "type": "range", "id": "veil", "label": "Dark overlay strength", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "veil_color", "label": "Dark overlay tint colour", "default": "#120E0A" },
    { "type": "color", "id": "glow_color", "label": "Warm light colour", "default": "#D9A25A" },
    { "type": "range", "id": "glow_strength", "label": "Warm light strength", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 30 },

    { "type": "header", "content": "6. Colors" },
    { "type": "color", "id": "text_color", "label": "Stone name and note titles", "default": "#F4EBE1" },
    { "type": "color", "id": "muted_color", "label": "Note text", "default": "#D9CFC2" },
    { "type": "checkbox", "id": "use_stone_color", "label": "Colour lines and arrow to match each stone", "default": true },
    { "type": "color", "id": "accent_color", "label": "Fallback line & arrow colour", "default": "#C9A15B" }
  ],
  "blocks": [
    {
      "type": "gem",
      "name": "Gemstone",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Square, the stone alone on a plain ivory background. A stone without a photo is left out of the wheel." },
        { "type": "image_picker", "id": "side_image", "label": "Photo shown on the left (side view)", "info": "The stone standing upright, seen from the side, on a transparent background. Leave empty to use the built-in side view." },
        { "type": "image_picker", "id": "angle_2", "label": "Second angle (optional)", "info": "Same framing, turned. Shown on the left in turn with the main photo." },
        { "type": "image_picker", "id": "angle_3", "label": "Third angle (optional)" },
        { "type": "text", "id": "name", "label": "Name", "default": "EMERALD" },
        { "type": "textarea", "id": "text", "label": "Importance", "default": "Cultivates intellect, eloquent speech, emotional composure, and clear discernment." },
        { "type": "textarea", "id": "features", "label": "Features", "info": "Leave empty to use the built-in text." },
        { "type": "textarea", "id": "uses", "label": "Uses", "info": "Leave empty to use the built-in text." },
        { "type": "text", "id": "wear", "label": "Traditionally worn", "info": "Leave empty to use the built-in text." }
      ]
    }
  ],
  "max_blocks": 18,
  "presets": [
    {
      "name": "4. Rotating Gemstones"
    }
  ]
}
{% endschema %}
