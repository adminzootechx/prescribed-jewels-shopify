{%- assign s = section.settings -%}

<section
  id="pj-product-page"
  class="pj-pdp"
  data-route-section="product"
  aria-labelledby="pj-pdp-title"
  style="
    --pj-pdp-pt: {{ s.padding_top | default: 48 }}px;
    --pj-pdp-pb: {{ s.padding_bottom | default: 72 }}px;
    --pj-pdp-max-w: {{ s.max_width | default: 1280 }}px;
    --pj-pdp-ratio: {{ s.image_aspect_ratio | default: '4 / 5' }};
    {% if s.bg_color != blank %}--pj-pdp-bg: {{ s.bg_color }};{% endif %}
    {% if s.text_color != blank %}--pj-pdp-text: {{ s.text_color }};{% endif %}
    {% if s.accent_color != blank %}--pj-pdp-accent: {{ s.accent_color }};{% endif %}
  "
>
  {% render 'pj-product-content',
    product: product,
    eyebrow: s.eyebrow,
    price_note: s.price_note,
    included_text: s.included_text,
    timeline_text: s.timeline_text,
    shipping_text: s.shipping_text,
    placeholder_design: s.placeholder_design,
    placeholder_title: s.placeholder_title,
    placeholder_price: s.placeholder_price,
    placeholder_description: s.placeholder_description
  %}
</section>

<script>
  (() => {
    const sec = document.getElementById('pj-product-page');
    if (!sec) return;
    const is404Template = document.body.classList.contains('template-404');
    if (is404Template) {
      const path = window.location.pathname.toLowerCase();
      const isProductRoute = path.includes('/products/') || path.includes('product') || path.includes('design') || path.includes('classic') || path.includes('solace') || path.includes('balance') || path.includes('aura') || path.includes('signet') || path.includes('celestial') || path.includes('bespoke');
      sec.style.display = isProductRoute && !path.includes('contact') ? '' : 'none';
    }
  })();
</script>

{% schema %}
{
  "name": "Product — Natal Order",
  "tag": "div",
  "class": "pj-section-product",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SIGNATURE DESIGN · PRESCRIBED JEWELS" },
    { "type": "text", "id": "price_note", "label": "Note under price", "default": "The personal gemstone selection is included." },
    { "type": "textarea", "id": "included_text", "label": "What's Included", "default": "Your chosen fine jewelry design, a natural gemstone prescribed from your birth details (date, time, city and country) by our Vedic astrologer, a personal prescription card explaining your stone and its meaning, and signature Prescribed Jewels packaging." },
    { "type": "textarea", "id": "timeline_text", "label": "Prescription & Timeline", "default": "Day 0 — Order placed with your birth date, time, city and country. Days 1–5 — Our astrologer prescribes your gemstone. Days 3–7 — Your gemstone and its meaning are revealed by email. Weeks 5–7 — Your jewel is crafted, quality-checked and delivered." },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping & Care", "default": "Insured worldwide shipping with tracking. Store your piece in its signature box, avoid perfumes and harsh chemicals, and wipe gently with a soft lint-free cloth after wear." },

    { "type": "header", "content": "Placeholder Defaults" },
    { "type": "select", "id": "placeholder_design", "label": "Placeholder design", "default": "1", "options": [
      { "value": "1", "label": "01 — The Classic" },
      { "value": "2", "label": "02 — The Solace" },
      { "value": "3", "label": "03 — The Balance" },
      { "value": "4", "label": "04 — The Aura" },
      { "value": "5", "label": "05 — The Signet" },
      { "value": "6", "label": "06 — The Celestial" },
      { "value": "7", "label": "07 — Custom Bespoke" }
    ] },
    { "type": "text", "id": "placeholder_title", "label": "Placeholder title", "default": "The Classic — Signature Ring" },
    { "type": "text", "id": "placeholder_price", "label": "Placeholder price text", "default": "$2,400" },
    { "type": "richtext", "id": "placeholder_description", "label": "Placeholder description", "default": "<p>A timeless solitaire silhouette in solid 18k gold, designed to be worn every day. The centre stone is not chosen from a menu — it is prescribed for you from your date, time, city and country of birth.</p>" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "image_aspect_ratio", "label": "Image ratio", "default": "4 / 5", "options": [
      { "value": "1 / 1", "label": "Square (1:1)" },
      { "value": "4 / 5", "label": "Portrait (4:5)" },
      { "value": "3 / 4", "label": "Classic (3:4)" }
    ] },
    { "type": "range", "id": "max_width", "label": "Container max width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F3ECE0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1815" },
    { "type": "color", "id": "accent_color", "label": "Accent (gold)", "default": "#9A7440" }
  ],
  "presets": [
    {
      "name": "Product — Natal Order"
    }
  ]
}
{% endschema %}
