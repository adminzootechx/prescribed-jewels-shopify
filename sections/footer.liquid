{%- assign s = section.settings -%}
{%- assign bg_op = s.bg_opacity | default: 100 -%}

<footer
  class="pj-footer{% if s.show_border_top == false %} pj-footer--no-border{% endif %}"
  role="contentinfo"
  style="
    --pj-ftr-pt: {{ s.padding_top | default: 64 }}px;
    --pj-ftr-pb: {{ s.padding_bottom | default: 40 }}px;
    --pj-ftr-max-w: {{ s.max_width | default: 1360 }}px;
    --pj-ftr-logo-scale: {{ s.logo_scale | default: 100 | divided_by: 100.0 }};
    --pj-ftr-link-size: {{ s.link_size | default: 100 | divided_by: 100.0 }};
    --pj-ftr-social-size: {{ s.social_size | default: 18 }}px;
    padding-top: var(--pj-ftr-pt);
    padding-bottom: var(--pj-ftr-pb);
    {% if s.bg_color != blank %}
      {% if bg_op < 100 %}
        --pj-ftr-bg: color-mix(in srgb, {{ s.bg_color }} {{ bg_op }}%, transparent);
      {% else %}
        --pj-ftr-bg: {{ s.bg_color }};
      {% endif %}
    {% endif %}
    {% if s.border_color != blank %}--pj-ftr-border: {{ s.border_color }};{% endif %}
    {% if s.logo_color != blank %}--pj-ftr-logo-color: {{ s.logo_color }};{% endif %}
    {% if s.link_color != blank %}--pj-ftr-link-color: {{ s.link_color }};{% endif %}
    {% if s.link_hover_color != blank %}--pj-ftr-link-hover: {{ s.link_hover_color }};{% endif %}
    {% if s.social_color != blank %}--pj-ftr-social-color: {{ s.social_color }};{% endif %}
    {% if s.social_hover_color != blank %}--pj-ftr-social-hover: {{ s.social_hover_color }};{% endif %}
  "
>
  <div class="pj-container pj-footer__container">
    {%- if s.show_wordmark -%}
      <div class="pj-footer__brand-mark">
        <a href="{{ routes.root_url }}" class="pj-footer__logo" aria-label="{{ shop.name | default: 'Prescribed Jewels' }}">
          {% render 'pj-monogram', variant: 'wordmark' %}
        </a>
      </div>
    {%- endif -%}

    <div class="pj-footer__grid">
      <!-- Column 1: About Brand + Socials -->
      <div class="pj-footer__col pj-footer__col--about">
        <h3 class="pj-footer__heading">{{ s.about_heading | default: 'About Prescribed Jewels' }}</h3>
        <p class="pj-footer__tagline">{{ s.about_tagline | default: 'Ancient wisdom, modern fine jewelry — prescribed for you.' }}</p>

        <div class="pj-footer__socials">
          <a
            href="{{ s.instagram_url | default: 'https://www.instagram.com/prescribed.jewels?exln=dGVsc2ZjdTloM2g=' }}"
            class="pj-footer__social-circle"
            aria-label="Instagram @prescribed.jewels"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          </a>

          <a
            href="mailto:{{ s.email_address | default: 'hello@prescribedjewels.com' }}"
            class="pj-footer__social-circle"
            aria-label="Email {{ s.email_address | default: 'hello@prescribedjewels.com' }}"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Learn and Support -->
      <div class="pj-footer__col">
        <h3 class="pj-footer__heading">{{ s.col2_heading | default: 'Learn and Support' }}</h3>
        <ul class="pj-footer__list" role="list">
          {%- assign support_blocks = section.blocks | where: 'type', 'support_link' -%}
          {%- if support_blocks.size > 0 -%}
            {%- for block in support_blocks -%}
              {%- liquid
                assign raw_link = block.settings.link | default: '#'
                assign first_char = raw_link | slice: 0, 1
                if first_char == '#' and raw_link.size > 1 and template.name != 'index'
                  assign resolved_link = routes.root_url | append: raw_link
                else
                  assign resolved_link = raw_link
                endif
              -%}
              <li class="pj-footer__list-item" {{ block.shopify_attributes }}>
                {%- if block.settings.open_modal -%}
                  <button type="button" class="pj-footer__nav-link pj-footer__nav-btn" data-open-prescription data-design="07 — Custom Bespoke Commission">
                    {{ block.settings.label }}
                  </button>
                {%- else -%}
                  <a href="{{ resolved_link }}" class="pj-footer__nav-link">{{ block.settings.label }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="pj-footer__list-item">
              <a href="{% if template.name != 'index' %}{{ routes.root_url }}{% endif %}#pj-story" class="pj-footer__nav-link">Our Story</a>
            </li>
            <li class="pj-footer__list-item">
              <a href="{% if template.name != 'index' %}{{ routes.root_url }}{% endif %}#pj-process" class="pj-footer__nav-link">The Prescription</a>
            </li>
            <li class="pj-footer__list-item">
              <a href="{% if template.name != 'index' %}{{ routes.root_url }}{% endif %}#pj-gemstones" class="pj-footer__nav-link">About Navaratna Gemstones</a>
            </li>
            <li class="pj-footer__list-item">
              <button type="button" class="pj-footer__nav-link pj-footer__nav-btn" data-open-prescription data-design="07 — Custom Bespoke Commission">Bespoke</button>
            </li>
            <li class="pj-footer__list-item">
              <a href="/pages/contact" class="pj-footer__nav-link">Contact Us</a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 3: Our Products -->
      <div class="pj-footer__col">
        <h3 class="pj-footer__heading">{{ s.col3_heading | default: 'Our Products' }}</h3>
        <ul class="pj-footer__list" role="list">
          {%- assign product_blocks = section.blocks | where: 'type', 'product_link' -%}
          {%- if product_blocks.size > 0 -%}
            {%- for block in product_blocks -%}
              {%- liquid
                assign raw_link = block.settings.link | default: '#'
                assign first_char = raw_link | slice: 0, 1
                if first_char == '#' and raw_link.size > 1 and template.name != 'index'
                  assign resolved_link = routes.root_url | append: raw_link
                else
                  assign resolved_link = raw_link
                endif
              -%}
              <li class="pj-footer__list-item" {{ block.shopify_attributes }}>
                {%- if block.settings.open_modal -%}
                  <button type="button" class="pj-footer__nav-link pj-footer__nav-btn" data-open-prescription data-design="{{ block.settings.modal_design | default: '07 — Custom Bespoke Commission' }}">
                    {{ block.settings.label }}
                  </button>
                {%- else -%}
                  <a href="{{ resolved_link }}" class="pj-footer__nav-link">{{ block.settings.label }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="pj-footer__list-item">
              <a href="{% if template.name != 'index' %}{{ routes.root_url }}{% endif %}#pj-designs" class="pj-footer__nav-link">The Classic — Rings</a>
            </li>
            <li class="pj-footer__list-item">
              <a href="{% if template.name != 'index' %}{{ routes.root_url }}{% endif %}#pj-designs" class="pj-footer__nav-link">The Solace — Pendants</a>
            </li>
            <li class="pj-footer__list-item">
              <a href="{% if template.name != 'index' %}{{ routes.root_url }}{% endif %}#pj-designs" class="pj-footer__nav-link">The Balance — Bracelets</a>
            </li>
            <li class="pj-footer__list-item">
              <a href="{% if template.name != 'index' %}{{ routes.root_url }}{% endif %}#pj-designs" class="pj-footer__nav-link">The Aura — Earrings</a>
            </li>
            <li class="pj-footer__list-item">
              <a href="{% if template.name != 'index' %}{{ routes.root_url }}{% endif %}#pj-designs" class="pj-footer__nav-link">The Signet &amp; Medallions</a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 4: Join Our Mailing List -->
      <div class="pj-footer__col pj-footer__col--newsletter">
        <h3 class="pj-footer__heading">{{ s.newsletter_heading | default: 'Join Our Mailing List' }}</h3>
        <p class="pj-footer__newsletter-text">
          {{ s.newsletter_text | default: 'Sign up to receive email updates on new designs, gemstone insights, private consultations, and bespoke creations.' }}
        </p>

        {%- form 'customer', id: 'pj-footer-newsletter', class: 'pj-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="pj-footer__newsletter-msg" role="status">Thank you for subscribing.</p>
          {%- elsif form.errors -%}
            <p class="pj-footer__newsletter-msg pj-footer__newsletter-msg--error" role="alert">
              {{ form.errors | default_errors }}
            </p>
          {%- endif -%}

          <div class="pj-footer__newsletter-row">
            <label for="pj-footer-email" class="pj-visually-hidden">Email Address</label>
            <input
              type="email"
              id="pj-footer-email"
              name="contact[email]"
              class="pj-footer__newsletter-input"
              value="{{ form.email }}"
              placeholder="Email Address"
              autocorrect="off"
              autocapitalize="off"
              required
            >
            <button type="submit" class="pj-footer__newsletter-submit">
              Subscribe
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>

    <!-- Bottom Row: Copyright + Legal Links + Back to Top -->
    <div class="pj-footer__bottom">
      <p class="pj-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | default: 'Prescribed Jewels' }}. All Rights Reserved.
      </p>

      <div class="pj-footer__bottom-right">
        <div class="pj-footer__legal">
          <a href="{{ s.terms_url | default: '/pages/contact' }}" class="pj-footer__legal-link">Terms and Conditions</a>
          <a href="{{ s.privacy_url | default: '/pages/contact' }}" class="pj-footer__legal-link">Privacy Policy</a>
        </div>

        <button
          type="button"
          class="pj-footer__to-top"
          aria-label="Back to top"
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5"/>
            <path d="M5 12l7-7 7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "pj-section-footer",
  "settings": [
    { "type": "header", "content": "Column 1 — Brand & Socials" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show subtle top wordmark", "default": true },
    { "type": "text", "id": "about_heading", "label": "About heading", "default": "About Prescribed Jewels" },
    { "type": "textarea", "id": "about_tagline", "label": "Brand tagline", "default": "Ancient wisdom, modern fine jewelry — prescribed for you." },
    { "type": "text", "id": "instagram_url", "label": "Instagram URL", "default": "https://www.instagram.com/prescribed.jewels?exln=dGVsc2ZjdTloM2g=" },
    { "type": "text", "id": "email_address", "label": "Contact Email", "default": "hello@prescribedjewels.com" },

    { "type": "header", "content": "Column 2 & 3 Headings" },
    { "type": "text", "id": "col2_heading", "label": "Column 2 heading", "default": "Learn and Support" },
    { "type": "text", "id": "col3_heading", "label": "Column 3 heading", "default": "Our Products" },

    { "type": "header", "content": "Column 4 — Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join Our Mailing List" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter description", "default": "Sign up to receive email updates on new designs, gemstone insights, private consultations, and bespoke creations." },

    { "type": "header", "content": "Bottom Bar" },
    { "type": "text", "id": "inquire_label", "label": "Inquire button label", "default": "Inquire" },
    { "type": "url", "id": "terms_url", "label": "Terms and Conditions link" },
    { "type": "url", "id": "privacy_url", "label": "Privacy Policy link" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#301D0A" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "show_border_top", "label": "Show top border", "default": true },
    { "type": "color", "id": "border_color", "label": "Top border line color", "default": "rgba(244, 235, 225, 0.12)" },
    { "type": "color", "id": "logo_color", "label": "Headings & Logo color", "default": "#F4EBE1" },
    { "type": "color", "id": "link_color", "label": "Links & body text color", "default": "#E2D5C4" },
    { "type": "color", "id": "link_hover_color", "label": "Links hover color", "default": "#FFFFFF" },
    { "type": "color", "id": "social_color", "label": "Social icons color", "default": "#E2D5C4" },
    { "type": "color", "id": "social_hover_color", "label": "Social icons hover color", "default": "#FFFFFF" },

    { "type": "header", "content": "Layout, Sizes & Padding" },
    { "type": "range", "id": "max_width", "label": "Container Max Width", "min": 900, "max": 1800, "step": 20, "unit": "px", "default": 1360 },
    { "type": "range", "id": "logo_scale", "label": "Logo Size Scale (%)", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "link_size", "label": "Link Text Size (%)", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "link_gap", "label": "Space Between Links", "min": 12, "max": 60, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "social_size", "label": "Social Icons Size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 10, "max": 120, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 10, "max": 120, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "support_link",
      "name": "Learn & Support link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Our Story" },
        { "type": "text", "id": "link", "label": "Link (URL or #anchor)", "default": "#pj-story" },
        { "type": "checkbox", "id": "open_modal", "label": "Open Bespoke / Prescription modal", "default": false }
      ]
    },
    {
      "type": "product_link",
      "name": "Product / Design link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Rings" },
        { "type": "text", "id": "link", "label": "Link (URL or #anchor)", "default": "#pj-designs" },
        { "type": "checkbox", "id": "open_modal", "label": "Open Bespoke / Prescription modal", "default": false },
        { "type": "text", "id": "modal_design", "label": "Modal pre-selected design", "default": "01 — The Classic (Signature Ring)" }
      ]
    },
    {
      "type": "link",
      "name": "Legacy Footer link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Jewels" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
