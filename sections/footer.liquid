{%- assign s = section.settings -%}
{%- assign bg_op = s.bg_opacity | default: 100 -%}

<footer
  class="pj-footer{% if s.show_border_top == false %} pj-footer--no-border{% endif %}"
  role="contentinfo"
  style="
    --pj-ftr-pt: {{ s.padding_top | default: 28 }}px;
    --pj-ftr-pb: {{ s.padding_bottom | default: 28 }}px;
    padding-top: var(--pj-ftr-pt);
    padding-bottom: var(--pj-ftr-pb);
    {% if s.bg_color != blank %}
      {% if bg_op < 100 %}
        --pj-ftr-bg: color-mix(in srgb, {{ s.bg_color }} {{ bg_op }}%, transparent);
      {% else %}
        --pj-ftr-bg: {{ s.bg_color }};
      {% endif %}
    {% endif %}
    {% if s.border_color != blank %}--pj-ftr-border: {{ s.border_color }};{% endif %}
    {% if s.logo_color != blank %}--pj-ftr-logo-color: {{ s.logo_color }};{% endif %}
    {% if s.link_color != blank %}--pj-ftr-link-color: {{ s.link_color }};{% endif %}
    {% if s.link_hover_color != blank %}--pj-ftr-link-hover: {{ s.link_hover_color }};{% endif %}
    {% if s.social_color != blank %}--pj-ftr-social-color: {{ s.social_color }};{% endif %}
    {% if s.social_hover_color != blank %}--pj-ftr-social-hover: {{ s.social_hover_color }};{% endif %}
  "
>
  <div class="pj-container pj-footer__bar">
    <a href="{{ routes.root_url }}" class="pj-footer__logo" aria-label="{{ shop.name | default: 'Prescribed Jewels' }}">
      {% render 'pj-monogram', variant: 'wordmark' %}
    </a>

    <nav class="pj-footer__nav" aria-label="Footer Navigation">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="pj-footer__link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
      <button
        type="button"
        class="pj-footer__link pj-footer__link-btn"
        data-open-prescription
        data-design="07 — Custom Bespoke Commission"
      >
        {{ s.inquire_label }}
      </button>
    </nav>

    <div class="pj-footer__socials">
      <a href="#pj-designs" class="pj-footer__social-icon" aria-label="Instagram">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <rect x="3" y="3" width="18" height="18" rx="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
        </svg>
      </a>
      <a href="#pj-designs" class="pj-footer__social-icon" aria-label="Pinterest">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="12" cy="12" r="9"/>
          <path d="M10 17l1.5-6.5M10.5 13.5c.5.8 1.5 1.2 2.5 1.2 2 0 3.2-1.6 3.2-3.7 0-2-1.6-3.5-4-3.5-2.6 0-4.2 1.7-4.2 3.8 0 .9.3 1.7.9 2.2" stroke-linecap="round"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "pj-section-footer",
  "settings": [
    { "type": "header", "content": "Navigation & Actions" },
    { "type": "text", "id": "inquire_label", "label": "Inquire button label", "default": "Inquire" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#120E0A" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100, "info": "Adjust to make the footer background transparent or blend with dark page background." },
    { "type": "checkbox", "id": "show_border_top", "label": "Show top border", "default": true },
    { "type": "color", "id": "border_color", "label": "Top border line color", "default": "rgba(244, 235, 225, 0.1)" },
    { "type": "color", "id": "logo_color", "label": "Logo / Brand text color", "default": "#E9D2AF" },
    { "type": "color", "id": "link_color", "label": "Links color", "default": "#A6998A" },
    { "type": "color", "id": "link_hover_color", "label": "Links hover color", "default": "#E9D2AF" },
    { "type": "color", "id": "social_color", "label": "Social icons color", "default": "#A6998A" },
    { "type": "color", "id": "social_hover_color", "label": "Social icons hover color", "default": "#E9D2AF" },

    { "type": "header", "content": "Layout & Padding" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 10, "max": 100, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 10, "max": 100, "step": 2, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Footer link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Jewels" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
