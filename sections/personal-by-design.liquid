{%- assign s = section.settings -%}
{%- assign lines = s.tagline | newline_to_br | split: '<br />' -%}
{%- assign emblem_pos = s.emblem_position | default: 'left' -%}
{%- assign tagline_pos = s.tagline_position | default: 'right' -%}

<section
  id="pj-philosophy-{{ section.id }}"
  class="pj-philosophy{% if s.border_top %} pj-philosophy--border-top{% endif %}{% if s.border_bottom %} pj-philosophy--border-bottom{% endif %}"
  style="
    --pj-phi-bg: {{ s.bg_color | default: '#F4EEE5' }};
    --pj-phi-text: {{ s.text_color | default: '#1E1B18' }};
    --pj-phi-body: {{ s.body_color | default: '#574F44' }};
    --pj-phi-accent: {{ s.accent_color | default: '#8B7D6B' }};
    --pj-phi-border: {{ s.border_color | default: 'rgba(26, 24, 21, 0.12)' }};
    --pj-phi-pt: {{ s.padding_top | default: 56 }}px;
    --pj-phi-pb: {{ s.padding_bottom | default: 56 }}px;
    --pj-phi-max-w: {{ s.max_width | default: 1200 }}px;
    --pj-phi-heading-size: {{ s.heading_size | default: 100 | divided_by: 100.0 }};
    --pj-phi-body-size: {{ s.body_size | default: 100 | divided_by: 100.0 }};
    --pj-phi-emblem-size: {{ s.emblem_size | default: 135 }}px;
    {% if s.section_height > 0 %} --pj-phi-min-h: {{ s.section_height }}vh;{% endif %}
    --pj-phi-scale: {{ s.section_scale | default: 100 | divided_by: 100.0 }};
  "
>
  {%- if s.bg_image != blank -%}
    <div class="pj-philosophy__bg" aria-hidden="true">
      {{ s.bg_image | image_url: width: 2400 | image_tag: class: 'pj-philosophy__bg-img', widths: '800, 1400, 2000, 2400', sizes: '100vw', alt: '', loading: 'lazy' }}
    </div>
  {%- endif -%}

  {%- capture emblem_html -%}
    {%- if s.show_emblem -%}
      <div class="pj-philosophy__emblem pj-philosophy__emblem--{{ emblem_pos }}" style="color: {{ s.emblem_color | default: '#8B7D6B' }};">
        {%- if s.emblem_image != blank -%}
          {{ s.emblem_image | image_url: width: 400 | image_tag: class: 'pj-philosophy__emblem-img', alt: 'Celestial Emblem', loading: 'lazy' }}
        {%- else -%}
          {% render 'pj-celestial-emblem' %}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture tagline_html -%}
    {%- if s.show_tagline and s.tagline != blank and tagline_pos != 'none' -%}
      <div class="pj-philosophy__tagline pj-philosophy__tagline--{{ tagline_pos }}" aria-label="Brand mantra">
        <span class="pj-philosophy__tagline-bar" aria-hidden="true"></span>
        <div class="pj-philosophy__tagline-words">
          {%- for line in lines -%}
            {%- assign clean_line = line | strip_html | strip -%}
            {%- if clean_line != blank -%}
              <span class="pj-philosophy__tagline-word">{{ clean_line }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  <div class="pj-philosophy__inner pj-philosophy__inner--emblem-{{ emblem_pos }}">
    {%- if emblem_pos == 'left' -%}
      {{ emblem_html }}
      <div class="pj-philosophy__center">
        {%- if s.heading != blank -%}
          <h2 class="pj-philosophy__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if s.body_text != blank -%}
          <div class="pj-philosophy__body">
            <p>{{ s.body_text | newline_to_br }}</p>
          </div>
        {%- endif -%}
      </div>
      {{ tagline_html }}
    {%- else -%}
      {{ tagline_html }}
      <div class="pj-philosophy__center">
        {%- if s.heading != blank -%}
          <h2 class="pj-philosophy__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if s.body_text != blank -%}
          <div class="pj-philosophy__body">
            <p>{{ s.body_text | newline_to_br }}</p>
          </div>
        {%- endif -%}
      </div>
      {{ emblem_html }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Personal by Design",
  "tag": "section",
  "class": "pj-section-philosophy",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PERSONAL BY DESIGN"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "In Vedic astrology, your birth chart is a map of your inner world — your strengths, challenges and potential. We translate this into fine jewelry, thoughtfully designed and set with gemstones that support your unique energy. Pieces that are personal, meaningful and made for your everyday life."
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Emblem"
    },
    {
      "type": "checkbox",
      "id": "show_emblem",
      "label": "Show celestial emblem",
      "default": true
    },
    {
      "type": "select",
      "id": "emblem_position",
      "label": "Emblem position",
      "options": [
        { "value": "left", "label": "Left (Recommended)" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "emblem_image",
      "label": "Custom emblem image",
      "info": "Optional. Leave blank to display the built-in celestial sun & moon emblem."
    },
    {
      "type": "color",
      "id": "emblem_color",
      "label": "Emblem color",
      "default": "#8B7D6B"
    },
    {
      "type": "range",
      "id": "emblem_size",
      "label": "Emblem size",
      "min": 70,
      "max": 250,
      "step": 5,
      "unit": "px",
      "default": 135
    },
    {
      "type": "header",
      "content": "Tagline (Mantra)"
    },
    {
      "type": "checkbox",
      "id": "show_tagline",
      "label": "Show vertical tagline",
      "default": true
    },
    {
      "type": "select",
      "id": "tagline_position",
      "label": "Tagline position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" },
        { "value": "none", "label": "Hidden" }
      ],
      "default": "right"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline lines",
      "info": "Press Enter for each stacked line.",
      "default": "ANCIENT\nWISDOM\nMODERN\nJEWELRY"
    },
    {
      "type": "header",
      "content": "Colors & Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F4EEE5"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background texture / image",
      "info": "Optional subtle texture or image."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#1E1B18"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#574F44"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Tagline & line color",
      "default": "#8B7D6B"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders color",
      "default": "rgba(26, 24, 21, 0.12)"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Show top border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout, Spacing & Screen Fit"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Min Height (Screen Fit)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 0,
      "info": "0 = Auto fit content. 100 = 100vh full screen fit."
    },
    {
      "type": "range",
      "id": "section_scale",
      "label": "Section Overall Scale (%)",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scale elements up or down proportionally"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum container width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Personal by Design"
    }
  ]
}
{% endschema %}
