<section id="pj-designs" class="pj-designs-scroll-outer" aria-labelledby="pj-designs-heading" data-horizontal-designs style="--pj-hs-sec: {{ section.settings.heading_size | divided_by: 100.0 }};">
  <div class="pj-designs-sticky">
    <div class="pj-container">
      <div class="pj-designs__header">
        <div class="pj-designs__header-left">
          <p class="pj-eyebrow">{{ section.settings.eyebrow }}</p>
          <h2 id="pj-designs-heading" class="pj-section-title">{{ section.settings.heading | escape | newline_to_br }}</h2>
        </div>
        <div class="pj-designs__header-line" aria-hidden="true"></div>
        <div class="pj-designs__arrows">
          <button type="button" class="pj-designs__arrow-btn" id="pj-designs-prev" aria-label="Previous designs">
            ←
          </button>
          <button type="button" class="pj-designs__arrow-btn" id="pj-designs-next" aria-label="Next designs">
            →
          </button>
        </div>
      </div>
    </div>

    <div class="pj-designs__viewport" id="pj-designs-viewport">
      <div class="pj-designs__track" id="pj-designs-track">
        {%- assign fallbacks = 'design-01-classic.jpg,design-02-solace.jpg,design-03-balance.jpg,design-04-aura.jpg,design-05-signet.jpg,design-06-celestial.jpg,design-07-bespoke.jpg' | split: ',' -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article class="pj-design-tile {% cycle 'pj-design-tile--up', 'pj-design-tile--down' %}{% if b.is_custom %} pj-design-tile--custom{% endif %}" {{ block.shopify_attributes }}>
            <div class="pj-design-tile__media">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 900 | image_tag: class: 'pj-design-tile__img', widths: '450, 600, 900', sizes: '(min-width: 960px) 28vw, 80vw', alt: b.name, loading: 'lazy' }}
              {%- else -%}
                <img src="{{ fallbacks[forloop.index0] | default: fallbacks[0] | asset_url }}" alt="{{ b.name | escape }}" class="pj-design-tile__img" width="600" height="800" loading="lazy">
              {%- endif -%}
            </div>
            <div class="pj-design-tile__info">
              <span class="pj-design-tile__num">{{ forloop.index | prepend: '0' }}</span>
              <h3 class="pj-design-tile__name">{{ b.name }}</h3>
              <button type="button" class="pj-design-tile__link" data-open-prescription data-design="{{ b.request_label | escape }}">{{ b.button_label }}</button>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "2. The 7 Designs",
  "tag": "section",
  "class": "pj-section-designs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE COLLECTION" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Press Enter for a new line.", "default": "SEVEN DESIGNS,\nONE MEANING" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 60, "max": 140, "step": 5, "unit": "%", "default": 100 }
  ],
  "blocks": [
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Portrait, 3:4." },
        { "type": "text", "id": "name", "label": "Name", "default": "THE CLASSIC" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "VIEW DETAILS →" },
        { "type": "text", "id": "request_label", "label": "Name shown on the order form", "default": "01 — The Classic (Signature Ring)" },
        { "type": "checkbox", "id": "is_custom", "label": "Style as the custom/bespoke tile", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "2. The 7 Designs", "blocks": [ { "type": "design" }, { "type": "design" }, { "type": "design" } ] }
  ]
}
{% endschema %}
