{%- assign s = section.settings -%}

<section
  id="pj-process-steps-{{ section.id }}"
  class="pj-process-steps"
  aria-labelledby="pj-process-steps-heading-{{ section.id }}"
  style="
    --pj-ps-bg: {{ s.bg_color | default: '#120E0A' }};
    --pj-ps-veil: {{ s.veil | default: 60 }}%;
    --pj-ps-veil-color: {{ s.veil_color | default: '#120E0A' }};
    --pj-ps-eyebrow-color: {{ s.eyebrow_color | default: '#B69156' }};
    --pj-ps-eyebrow-size: {{ s.eyebrow_size | default: 100 | divided_by: 100.0 }};
    --pj-ps-heading-color: {{ s.heading_color | default: '#F4EBE1' }};
    --pj-ps-hs: {{ s.heading_size | default: 115 | divided_by: 100.0 }};
    --pj-ps-step-num-color: {{ s.step_num_color | default: '#B69156' }};
    --pj-ps-step-num-size: {{ s.step_num_size | default: 100 | divided_by: 100.0 }};
    --pj-ps-step-title-color: {{ s.step_title_color | default: '#F4EBE1' }};
    --pj-ps-step-title-size: {{ s.step_title_size | default: 100 | divided_by: 100.0 }};
    --pj-ps-step-desc-color: {{ s.step_desc_color | default: '#C8BFB2' }};
    --pj-ps-step-desc-size: {{ s.step_desc_size | default: 100 | divided_by: 100.0 }};
    --pj-ps-step-desc-align: {{ s.step_desc_align | default: 'left' }};
    --pj-ps-header-align: {{ s.header_align | default: 'center' }};
    --pj-ps-img-ratio: {{ s.image_aspect_ratio | default: '191 / 133' }};
    --pj-ps-img-radius: {{ s.image_radius | default: 0 }}px;
    --pj-ps-img-border: {{ s.image_border_color | default: 'rgba(244, 235, 225, 0.12)' }};
    --pj-ps-card-bg: {{ s.card_bg | default: 'transparent' }};
    --pj-ps-card-pad: {{ s.card_padding | default: 0 }}px;
    --pj-ps-max-w: {{ s.max_width | default: 1240 }}px;
    --pj-ps-gap: {{ s.grid_gap | default: 24 }}px;
    --pj-ps-pt: {{ s.padding_top | default: 72 }}px;
    --pj-ps-pb: {{ s.padding_bottom | default: 72 }}px;
  "
>
  <div class="pj-process-steps__bg" aria-hidden="true">
    {%- if s.bg_image != blank -%}
      {{ s.bg_image | image_url: width: 2400 | image_tag: class: 'pj-process-steps__bg-img', widths: '800, 1400, 2000, 2400', sizes: '100vw', alt: '', loading: 'lazy' }}
    {%- else -%}
      <img src="{{ 'collection-stone-bg.png' | asset_url }}" alt="" class="pj-process-steps__bg-img" width="1920" height="1080" loading="lazy">
    {%- endif -%}
  </div>

  <div class="pj-container pj-process-steps__container">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="pj-process-steps__header">
        {%- if s.eyebrow != blank -%}
          <p class="pj-eyebrow pj-process-steps__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 id="pj-process-steps-heading-{{ section.id }}" class="pj-process-steps__title">
            {{ s.heading | escape }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pj-process-steps__grid">
      {%- assign fallback_imgs = 'process-step-1.png,process-step-2.png,process-step-3.png,process-step-4.png' | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article
          class="pj-process-step"
          style="
            {%- if b.custom_num_color != blank and b.custom_num_color != 'rgba(0,0,0,0)' -%}--pj-ps-step-num-color: {{ b.custom_num_color }};{%- endif -%}
            {%- if b.custom_title_color != blank and b.custom_title_color != 'rgba(0,0,0,0)' -%}--pj-ps-step-title-color: {{ b.custom_title_color }};{%- endif -%}
            {%- if b.custom_desc_color != blank and b.custom_desc_color != 'rgba(0,0,0,0)' -%}--pj-ps-step-desc-color: {{ b.custom_desc_color }};{%- endif -%}
          "
          {{ block.shopify_attributes }}
        >
          <div class="pj-process-step__head">
            <span class="pj-process-step__num">{{ b.step_number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="pj-process-step__name">{{ b.title }}</h3>
          </div>

          <div class="pj-process-step__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 600 | image_tag: class: 'pj-process-step__img', widths: '300, 450, 600', sizes: '(min-width: 900px) 22vw, 85vw', alt: b.title, loading: 'lazy' }}
            {%- else -%}
              {%- assign fallback_img = fallback_imgs[forloop.index0] | default: fallback_imgs[0] -%}
              <img src="{{ fallback_img | asset_url }}" alt="{{ b.title | escape }}" class="pj-process-step__img" width="382" height="266" loading="lazy">
            {%- endif -%}
          </div>

          {%- if b.description != blank -%}
            <p class="pj-process-step__desc">{{ b.description }}</p>
          {%- endif -%}

          {%- if b.link_url != blank and b.link_label != blank -%}
            <a href="{{ b.link_url }}" class="pj-process-step__link">
              <span>{{ b.link_label }}</span>
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Process Steps Grid",
  "tag": "section",
  "class": "pj-section-process-steps",
  "settings": [
    { "type": "header", "content": "Header Text & Sizes" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PROCESS" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 50, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#B69156" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A PIECE THAT'S TRULY YOURS" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 60, "max": 180, "step": 5, "unit": "%", "default": 115 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#F4EBE1" },
    { "type": "select", "id": "header_align", "label": "Header alignment", "default": "center", "options": [ { "value": "center", "label": "Center" }, { "value": "left", "label": "Left" } ] },

    { "type": "header", "content": "Step Card Text & Sizes" },
    { "type": "range", "id": "step_num_size", "label": "Step number size", "min": 50, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "step_num_color", "label": "Step number color", "default": "#B69156" },
    { "type": "range", "id": "step_title_size", "label": "Step title size", "min": 50, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "step_title_color", "label": "Step title color", "default": "#F4EBE1" },
    { "type": "range", "id": "step_desc_size", "label": "Description text size", "min": 50, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "step_desc_color", "label": "Description text color", "default": "#C8BFB2" },
    { "type": "select", "id": "step_desc_align", "label": "Description alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },

    { "type": "header", "content": "Step Image & Card Styling" },
    { "type": "select", "id": "image_aspect_ratio", "label": "Image ratio", "default": "191 / 133", "options": [
      { "value": "191 / 133", "label": "Wide 4:3 (Original)" },
      { "value": "1 / 1", "label": "Square (1:1)" },
      { "value": "16 / 9", "label": "Widescreen (16:9)" },
      { "value": "3 / 2", "label": "Classic (3:2)" }
    ] },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 },
    { "type": "color", "id": "image_border_color", "label": "Image border color", "default": "rgba(244, 235, 225, 0.12)" },
    { "type": "color", "id": "card_bg", "label": "Card background (optional)", "default": "transparent" },
    { "type": "range", "id": "card_padding", "label": "Card internal padding", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Section Background & Overlay" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#120E0A" },
    { "type": "image_picker", "id": "bg_image", "label": "Background Image", "info": "Leave blank to use the textured dark stone background." },
    { "type": "range", "id": "veil", "label": "Overlay strength", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 60 },
    { "type": "color", "id": "veil_color", "label": "Overlay tint", "default": "#120E0A" },

    { "type": "header", "content": "Layout & Spacing" },
    { "type": "range", "id": "max_width", "label": "Container maximum width", "min": 900, "max": 1400, "step": 20, "unit": "px", "default": 1240 },
    { "type": "range", "id": "grid_gap", "label": "Space between cards", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "step_number", "label": "Step number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "CHOOSE A DESIGN" },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Select from our eight signature designs or create a custom piece." },
        { "type": "header", "content": "Per-Step Color Overrides (Optional)" },
        { "type": "color", "id": "custom_num_color", "label": "Custom number color" },
        { "type": "color", "id": "custom_title_color", "label": "Custom title color" },
        { "type": "color", "id": "custom_desc_color", "label": "Custom description color" },
        { "type": "header", "content": "Link / Button (Optional)" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Process Steps Grid",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "01",
            "title": "CHOOSE A DESIGN",
            "description": "Select from our eight signature designs or create a custom piece."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "02",
            "title": "SHARE YOUR BIRTH DETAILS",
            "description": "Provide your birth date, exact time and place of birth so we can create your personal gemstone prescription."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "03",
            "title": "YOUR PRESCRIPTION",
            "description": "Our Vedic astrology process identifies the gemstones that best support your unique energy."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "04",
            "title": "CRAFTED FOR YOU",
            "description": "Your jewelry is thoughtfully crafted in fine materials, with gemstones prescribed just for you."
          }
        }
      ]
    }
  ]
}
{% endschema %}
