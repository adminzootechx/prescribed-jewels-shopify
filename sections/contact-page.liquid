{%- assign s = section.settings -%}

<section
  id="pj-contact"
  class="pj-contact-section"
  style="
    --pj-contact-bg: {{ s.bg_color | default: '#FFFFFF' }};
    --pj-contact-text: {{ s.text_color | default: '#1F2A44' }};
    --pj-contact-muted: {{ s.muted_color | default: '#3B4760' }};
    --pj-contact-btn-bg: {{ s.btn_bg_color | default: '#233352' }};
    --pj-contact-pt: {{ s.padding_top | default: 56 }}px;
    --pj-contact-pb: {{ s.padding_bottom | default: 80 }}px;
  "
>
  {% render 'pj-contact-content',
    image: s.image,
    heading: s.heading,
    subtext: s.subtext,
    email: s.email,
    insta_handle: s.insta_handle,
    insta_url: s.insta_url
  %}
</section>

{% schema %}
{
  "name": "Contact Us Page",
  "tag": "div",
  "class": "pj-section-contact",
  "settings": [
    { "type": "header", "content": "Image & Text" },
    { "type": "image_picker", "id": "image", "label": "Left Column Image (optional override)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in Touch" },
    { "type": "textarea", "id": "subtext", "label": "Subtitle", "default": "We'd love to hear from you. Whether you're enquiring about a piece, arranging a virtual appointment, or exploring a bespoke creation, our team is here to assist." },
    { "type": "text", "id": "email", "label": "Email Address", "default": "hello@prescribedjewels.com" },
    { "type": "text", "id": "insta_handle", "label": "Instagram Handle (without @)", "default": "prescribed.jewels" },
    { "type": "url", "id": "insta_url", "label": "Instagram Link URL" },
    { "type": "header", "content": "Colours & Spacing" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#1F2A44" },
    { "type": "color", "id": "muted_color", "label": "Body & link color", "default": "#3B4760" },
    { "type": "color", "id": "btn_bg_color", "label": "Send button color", "default": "#233352" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    {
      "name": "Contact Us Page"
    }
  ]
}
{% endschema %}
